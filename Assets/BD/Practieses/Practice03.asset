  m_Script: {fileID: 11500000, guid: 4f59830c2394c044cbfd4a4df643124d, type: 3}
  m_Name: Practice03
  m_EditorClassIdentifier: 
  ID: 80
  IsPractice: 1
  RussianText: "\u0422\u0435\u0445\u043D\u0438\u043A\u0430 \xAB\u0420\u043E\u0437\u043E\u0432\u044B\u0439
    \u043A\u0443\u0441\u0442\xBB \u0414\u0436\u043E\u043D\u0430 \u0410\u043B\u0430\u043D\u0430\r\n\u0426\u0435\u043B\u044C:
    \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0438\u0435 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438
    \u043E \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u043C \u043C\u0438\u0440\u0435
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430. \r\n\u0420\u0438\u0441\u0443\u044F
    \u0440\u043E\u0437\u043E\u0432\u044B\u0439 \u043A\u0443\u0441\u0442, \u0432\u044B
    \u0444\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u0440\u0438\u0441\u0443\u0435\u0442\u0435
    \u0441\u0432\u043E\u0439 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439
    \r\n\u043C\u0438\u0440, \u0430 \u0440\u043E\u0437\u043E\u0432\u044B\u0439 \u043A\u0443\u0441\u0442
    \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043C\u0435\u0442\u0430\u0444\u043E\u0440\u043E\u0439
    \u0432\u0430\u0448\u0435\u0433\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F.\r\n\u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0438\u044F:
    \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0440\u0438\u0441\u0443\u0439\u0442\u0435
    \u0440\u0438\u0441\u0443\u043D\u043E\u043A, \u0438 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \r\n\u043A\u0430\u043A
    \u0435\u0433\u043E \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435 \u0438
    \u0440\u0430\u0441\u043A\u0440\u0430\u0441\u0438\u0442\u0435, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
    \u0438\u043D\u0442\u0435\u0440\u043F\u0440\u0435\u0442\u0430\u0446\u0438\u044E.\r\n\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C:
    \u043B\u0438\u0441\u0442 \u0431\u0443\u043C\u0430\u0433\u0438 \u04104, \u0446\u0432\u0435\u0442\u043D\u044B\u0435
    \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u0438, \u043F\u0440\u043E\u0441\u0442\u043E\u0439\r\n\u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448,
    \u0430\u043A\u0432\u0430\u0440\u0435\u043B\u044C\u043D\u044B\u0435 \u043A\u0440\u0430\u0441\u043A\u0438
    \u0438\u043B\u0438 \u0444\u043B\u043E\u043C\u0430\u0441\u0442\u0435\u0440\u044B.\r\n\u0410\u043B\u0433\u043E\u0440\u0438\u0442\u043C
    \u0440\u0430\u0431\u043E\u0442\u044B\r\n\u0412\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435.\r\n\u0421\u044F\u0434\u044C\u0442\u0435
    \u0443\u0434\u043E\u0431\u043D\u043E, \u0437\u0430\u043A\u0440\u043E\u0439\u0442\u0435
    \u0433\u043B\u0430\u0437\u0430, \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u044C\u0442\u0435\u0441\u044C,
    \u0434\u044B\u0448\u0438\u0442\u0435 \u0440\u043E\u0432\u043D\u043E, \r\n\u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0438\u0432\u0448\u0438\u0441\u044C
    \u043D\u0430 \u0441\u0432\u043E\u0438\u0445 \u0442\u0435\u043B\u0435\u0441\u043D\u044B\u0445
    \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044F\u0445. \u041F\u0443\u0441\u0442\u0438\u0442\u0435
    \u0432 \u0445\u043E\u0434 \u0441\u0432\u043E\u0435 \r\n\u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435
    \u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0441\u0435\u0431\u0435,
    \u0447\u0442\u043E \u0432\u044B \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0438\u0441\u044C
    \u0432 \u043A\u0443\u0441\u0442 \u0440\u043E\u0437, \r\n\u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u0440\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435.
    \r\n\u2022 \u041A\u0430\u043A\u043E\u0439 \u044D\u0442\u043E \u043A\u0443\u0441\u0442:
    \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u043E\u0439,
    \u0432\u044B\u0441\u043E\u043A\u0438\u0439 \u0438\u043B\u0438 \u043D\u0438\u0437\u043A\u0438\u0439?
    \r\n\u2022 \u0415\u0441\u0442\u044C \u043B\u0438 \u043D\u0430 \u043D\u0435\u043C
    \u0446\u0432\u0435\u0442\u044B, \u0438 \u043A\u0430\u043A\u0438\u0435 \u043E\u043D\u0438:
    \u0432 \u0432\u0438\u0434\u0435 \u0431\u0443\u0442\u043E\u043D\u043E\u0432 \u0438\u043B\u0438
    \u0441 \r\n\u0440\u0430\u0441\u043F\u0443\u0449\u0435\u043D\u043D\u044B\u043C\u0438
    \u0446\u0432\u0435\u0442\u0430\u043C\u0438, \u043A\u0430\u043A\u0438\u0435 \u0432\u0435\u0442\u043A\u0438
    \u2013 \u0441 \u0448\u0438\u043F\u0430\u043C\u0438, \u0441 \u043B\u0438\u0441\u0442\u044C\u044F\u043C\u0438
    \u0438\u043B\u0438 \u0431\u0435\u0437 \r\n\u043D\u0438\u0445? \r\n\u2022 \u0415\u0441\u0442\u044C
    \u043B\u0438 \u0443 \u0432\u0430\u0448\u0435\u0433\u043E \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u043C\u043E\u0433\u043E
    \u043A\u0443\u0441\u0442\u0430 \u043A\u043E\u0440\u043D\u0438, \u043A\u0430\u043A
    \u0433\u043B\u0443\u0431\u043E\u043A\u043E \u043E\u043D\u0438 \r\n\u043F\u0440\u043E\u043D\u0438\u043A\u0430\u044E\u0442
    \u0432 \u0437\u0435\u043C\u043B\u044E. \r\n\u2022 \u0410 \u0433\u0434\u0435 \u0440\u0430\u0441\u0442\u0435\u0442
    \u043A\u0443\u0441\u0442: \u0432 \u0433\u043E\u0440\u043E\u0434\u0435, \u0432
    \u043F\u0443\u0441\u0442\u044B\u043D\u0435, \u043D\u0430 \u043A\u043B\u0443\u043C\u0431\u0435
    \u0438\u043B\u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \r\n\u0432
    \u0432\u0430\u0437\u0435? \r\n\u2022 \u0415\u0441\u0442\u044C \u043B\u0438 \u0432\u043E\u043A\u0440\u0443\u0433
    \u043A\u0443\u0441\u0442\u0430 \u0437\u0430\u0431\u043E\u0440, \u0434\u0435\u0440\u0435\u0432\u044C\u044F,
    \u0434\u0440\u0443\u0433\u0438\u0435 \u0446\u0432\u0435\u0442\u044B? \r\n\u2022
    \u041A\u0442\u043E \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u0437\u0430
    \u043A\u0443\u0441\u0442\u043E\u043C? \r\n\u2022 \u0410 \u043A\u043E\u0433\u0434\u0430
    \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u0445\u043E\u043B\u043E\u0434\u0430,
    \u043A\u0430\u043A \u043E\u043D \u0441\u0435\u0431\u044F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442?
    \r\n\u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0434\u043E
    \u0442\u043E\u043D\u0447\u0430\u0439\u0448\u0438\u0445 \u0434\u0435\u0442\u0430\u043B\u0435\u0439
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C, \u043A\u0430\u043A\u043E\u0432\u043E
    \u044D\u0442\u043E \u0431\u044B\u0442\u044C \u0440\u043E\u0437\u043E\u0432\u044B\u043C
    \u043A\u0443\u0441\u0442\u043E\u043C.\r\n\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C\r\n\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
    \u0433\u043B\u0430\u0437\u0430 \u0438 \u043D\u0430\u0440\u0438\u0441\u0443\u0439\u0442\u0435
    \u0441\u0435\u0431\u044F \u0432 \u0432\u0438\u0434\u0435 \u0440\u043E\u0437\u043E\u0432\u043E\u0433\u043E
    \u043A\u0443\u0441\u0442\u0430. \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \r\n\u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435
    \u043D\u0430 \u043B\u0438\u0441\u0442\u0435 \u0431\u0443\u043C\u0430\u0433\u0438
    \u043D\u0430\u0431\u0440\u043E\u0441\u043E\u043A \u043F\u0440\u043E\u0441\u0442\u044B\u043C
    \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u043E\u043C, \u0430 \u0437\u0430\u0442\u0435\u043C
    \r\n\u0440\u0430\u0441\u043A\u0440\u0430\u0441\u044C\u0442\u0435 \u0440\u0438\u0441\u0443\u043D\u043E\u043A
    \u0442\u0430\u043A, \u043A\u0430\u043A \u0437\u0430\u0445\u043E\u0442\u0438\u0442\u0435.\r\n\u0418\u043D\u0442\u0435\u0440\u043F\u0440\u0435\u0442\u0430\u0446\u0438\u044F:\r\no
    \u0420\u0430\u0437\u043C\u0435\u0440 \u0440\u0438\u0441\u0443\u043D\u043A\u0430\r\n\u041A\u0443\u0441\u0442
    \u0440\u043E\u0437 \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C
    \u043F\u043E \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044E \u043A \u043B\u0438\u0441\u0442\u0443
    \u0431\u0443\u043C\u0430\u0433\u0438 \u2013\r\n\u0433\u043E\u0432\u043E\u0440\u0438\u0442
    \u043E \u043D\u0435\u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u0447\u0435\u043C \u043C\u0435\u043D\u044C\u0448\u0435
    \u0440\u0438\u0441\u0443\u043D\u043E\u043A \u043F\u043E \r\n\u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044E
    \u043A \u0430\u043B\u044C\u0431\u043E\u043C\u043D\u043E\u043C\u0443 \u043B\u0438\u0441\u0442\u0443,
    \u0442\u0435\u043C \u044F\u0440\u0447\u0435 \u043F\u0440\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u0442\u0430\u043A\u043E\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E.\r\n\u041A\u0443\u0441\u0442
    \u0440\u043E\u0437 \u043E\u0447\u0435\u043D\u044C \u0431\u043E\u043B\u044C\u0448\u043E\u0439,
    \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E \u043D\u0435 \u043F\u043E\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 \u043B\u0438\u0441\u0442\u0435 \r\n\u0431\u0443\u043C\u0430\u0433\u0438
    \u2013 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u0441\u0438\u043B\u044C\u043D\u0443\u044E
    \u044D\u0433\u043E\u0446\u0435\u043D\u0442\u0440\u0438\u0447\u043D\u0443\u044E
    \u043F\u043E\u0437\u0438\u0446\u0438\u044E \u0438 \r\n\u0438\u043C\u043F\u0443\u043B\u044C\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u044C.\r\no
    \u0426\u0432\u0435\u0442\r\n\u0427\u0435\u0440\u043D\u044B\u0439 \u0446\u0432\u0435\u0442,
    \u0442\u0435\u043C\u043D\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0439,
    \u0441\u0435\u0440\u044B\u0439 \u0438 \u0432\u0441\u0435 \u0442\u0435\u043C\u043D\u044B\u0435
    \u0446\u0432\u0435\u0442\u0430 \u0432 \r\n\u0440\u0438\u0441\u0443\u043D\u043A\u0435
    \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u043C
    \u043D\u0435\u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u043D\u043E\u043C
    \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u043C
    \r\n\u0444\u043E\u043D\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.\r\n\u0412\u0441\u0435
    \u044F\u0440\u043A\u0438\u0435, \u0441\u043E\u0447\u043D\u044B\u0435, \u0442\u0435\u043F\u043B\u044B\u0435
    \u043A\u0440\u0430\u0441\u043A\u0438 \u0438 \u0438\u0445 \u043E\u0442\u0442\u0435\u043D\u043A\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438 \r\n\u0440\u0430\u0441\u043A\u0440\u0430\u0448\u0435\u043D
    \u0440\u0438\u0441\u0443\u043D\u043E\u043A, \u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0430\u043C\u0438 \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \r\n\u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u0438\u044F
    \u0438 \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439 \u0433\u0430\u0440\u043C\u043E\u043D\u0438\u0438.\r\no
    \u0411\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u043D\u044B\u0435
    \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0438 \u0440\u0438\u0441\u0443\u043D\u043A\u0430\r\n\u041F\u044B\u0448\u043D\u044B\u0439
    \u043A\u0443\u0441\u0442 \u0441 \u0433\u0443\u0441\u0442\u043E\u0439 \u043B\u0438\u0441\u0442\u0432\u043E\u0439,
    \u0441 \u043A\u0440\u0435\u043F\u043A\u0438\u043C\u0438 \u043A\u043E\u0440\u043D\u044F\u043C\u0438,
    \u0441 \r\n\u043C\u043D\u043E\u0433\u043E\u0447\u0438\u0441\u043B\u0435\u043D\u043D\u044B\u043C\u0438
    \u0431\u0443\u0442\u043E\u043D\u0430\u043C\u0438 \u0438\u043B\u0438 \u0440\u0430\u0441\u043F\u0443\u0441\u0442\u0438\u0432\u0448\u0438\u043C\u0438\u0441\u044F
    \u0446\u0432\u0435\u0442\u043A\u0430\u043C\u0438, \r\n\u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0440\u0430\u0441\u0442\u0435\u0442 \u0441 \u0434\u0440\u0443\u0433\u0438\u043C\u0438
    \u0442\u0430\u043A\u0438\u043C\u0438 \u0436\u0435 \u043A\u0443\u0441\u0442\u0430\u043C\u0438.
    \u041D\u0430 \u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u0438\u0435
    \r\n\u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u043C\u043E\u0433\u0443\u0442
    \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u0442\u0430\u043A\u0436\u0435
    \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043D\u043D\u043E\u0435 \r\n\u0441\u043E\u043B\u043D\u0446\u0435,
    \u043D\u0435\u0431\u043E, \u044F\u0440\u043A\u0438\u0435 \u0446\u0432\u0435\u0442\u044B,
    \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435 \u0432\u0441\u044F\u043A\u0438\u0445
    \u043E\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u0439 \u0438 \u0442. \u0434.\r\no
    \u041D\u0435\u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u043D\u044B\u0435
    \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u0438 \u0440\u0438\u0441\u0443\u043D\u043A\u0430\r\n\u0411\u043E\u043B\u044C\u0448\u043E\u0435
    \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u043A\u043E\u043B\u044E\u0447\u0435\u043A
    \u0438 \u0448\u0438\u043F\u043E\u0432 \u043D\u0430 \u0432\u0435\u0442\u0432\u044F\u0445
    \u2013 \u043F\u0440\u0438\u0437\u043D\u0430\u043A \r\n\u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u0438,
    \u043D\u043E \u0432 \u0442\u043E \u0436\u0435 \u0432\u0440\u0435\u043C\u044F
    \u043C\u043E\u0436\u0435\u0442 \u043E\u0437\u043D\u0430\u0447\u0430\u0442\u044C
    \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u044C \u0432 \u0437\u0430\u0449\u0438\u0442\u0435,
    \r\n\u0447\u0443\u0432\u0441\u0442\u0432\u0435 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.\r\n\u0413\u043E\u043B\u044B\u0435
    \u0432\u0435\u0442\u0432\u0438 \u0431\u0435\u0437 \u043B\u0438\u0441\u0442\u044C\u0435\u0432,
    \u043A\u043E\u0440\u043D\u0435\u0439, \u043A\u0443\u0441\u0442 \u0440\u0430\u0441\u0442\u0435\u0442
    \u043E\u0434\u0438\u043D\u043E\u043A\u043E \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435
    \r\n\u0438\u043B\u0438 \u0432\u0438\u0441\u0438\u0442 \u0431\u0443\u043A\u0432\u0430\u043B\u044C\u043D\u043E
    \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u2013 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
    \u043E \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u043C \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u043C
    \r\n\u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435, \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0435\u043D\u043D\u043E\u0441\u0442\u0438,
    \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043A\u0435 \u0434\u0443\u0448\u0435\u0432\u043D\u043E\u0433\u043E
    \u0442\u0435\u043F\u043B\u0430.\r\n\u0421\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0435
    \u0446\u0432\u0435\u0442\u044B \u043D\u0430 \u043A\u0443\u0441\u0442\u0435 \u0438\u043B\u0438
    \u0441\u0440\u0435\u0437\u0430\u043D\u043D\u044B\u0435 \u0432 \u0432\u0430\u0437\u0435
    \u2013 \u043F\u0440\u0438\u0437\u043D\u0430\u043A \u043D\u0435\u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u0438\u044F,
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u0430\u044F \u043F\u0441\u0438\u0445\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0442\u0440\u0430\u0432\u043C\u0430.\r\n\u0417\u0430\u0431\u043E\u0440, \u043E\u0433\u0440\u0430\u0434\u0430
    \u0438\u043B\u0438 \u0447\u0430\u0441\u0442\u043E\u043A\u043E\u043B \u0432\u043E\u043A\u0440\u0443\u0433
    \u043A\u0443\u0441\u0442\u0430 \u2013 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
    \u043D\u0430 \r\n\u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435
    \u043A\u0430\u043A\u0438\u0445-\u0442\u043E \u0441\u0442\u0440\u0430\u0445\u043E\u0432
    \u0432 \u0441\u0435\u0431\u0435, \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F
    \u0432 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u0445.\r\n\u0420\u0438\u0441\u0443\u043D\u043E\u043A
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D \u0432\u043D\u0438\u0437\u0443
    \u0430\u043B\u044C\u0431\u043E\u043C\u043D\u043E\u0433\u043E \u043B\u0438\u0441\u0442\u0430
    \u2013 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E \r\n\u0434\u0443\u0448\u0435\u0432\u043D\u043E\u043C
    \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442\u0435.\r\n\u041A\u043E\u0440\u0440\u0435\u043A\u0446\u0438\u044F
    \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0433\u043E \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F\r\n\u0427\u0442\u043E
    \u0434\u0435\u043B\u0430\u0442\u044C, \u0435\u0441\u043B\u0438 \u0432\u0430\u0448
    \u0440\u0438\u0441\u0443\u043D\u043E\u043A \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
    \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \r\n\u043D\u0435\u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u043D\u044B\u0445
    \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u043E\u0432? \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435
    \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
    \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \r\n\u0441\u0432\u043E\u0435
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435. \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E
    \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0434\u0432\u0443\u0445 \u043D\u0435\u0434\u0435\u043B\u044C
    \u0441\u043D\u043E\u0432\u0430 \u0438 \u0441\u043D\u043E\u0432\u0430 \r\n\u0440\u0438\u0441\u0443\u0439\u0442\u0435
    \u043A\u0443\u0441\u0442 \u0440\u043E\u0437, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044F,
    \u043A\u0430\u043A \u0437\u0430 \u043D\u0438\u043C \u0443\u0445\u0430\u0436\u0438\u0432\u0430\u044E\u0442,
    \u043A\u0430\u043A \u0435\u0433\u043E \r\n\u043F\u043E\u043B\u0438\u0432\u0430\u044E\u0442,
    \u043A\u0430\u043A \u0447\u0435\u0440\u0435\u0437 \u043A\u0430\u043A\u043E\u0435-\u0442\u043E
    \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u043D\u0435\u043C \u0440\u0430\u0441\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F
    \u0431\u0443\u0442\u043E\u043D\u044B, \r\n\u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
    \u044F\u0440\u043A\u043E-\u0437\u0435\u043B\u0435\u043D\u044B\u0435 \u043C\u043E\u043B\u043E\u0434\u044B\u0435
    \u043B\u0438\u0441\u0442\u0438\u043A\u0438. \u041A\u0443\u0441\u0442 \u043C\u043E\u0436\u0435\u0442
    \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C\u0441\u044F, \u0430 \r\n\u0432\u0441\u043B\u0435\u0434
    \u0437\u0430 \u043D\u0438\u043C \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0441\u044F
    \u0438 \u0432\u0430\u0448\u0435 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435,
    \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u0435\u0441\u044C \u0432\u044B."
  EnglishText: "John Alan's Rosebush Technique\r\nPurpose: obtaining information
    about the inner world of a person.\r\nBy drawing a rosebush, you are actually
    drawing your inner\r\nworld, and the rose bush is a metaphor for your condition.\r\nRecommendation:
    draw the picture first, and only after\r\nOnce you finish it and color it, look
    at the interpretation.\r\nEquipment: sheet of A4 paper, colored pencils, simple\r\npencil,
    watercolors or markers.\r\nWork algorithm\r\nIntroduction.\r\nSit comfortably,
    close your eyes, relax, breathe evenly,\r\nfocusing on your bodily sensations.
    Use yours\r\nimagination and imagine that you have turned into a rose bush,\r\nwhich
    you will consider carefully.\r\n\u2022 What kind of bush is it: small or large,
    tall or short?\r\n\u2022 Are there flowers on it, and what kind are they: in
    the form of buds or with\r\nopen flowers, which branches - with thorns, with
    leaves or without\r\nthem?\r\n\u2022 Does your imaginary bush have roots, how
    deep are they?\r\npenetrate into the ground.\r\n\u2022 Where does the bush grow:
    in the city, in the desert, in a flowerbed, or is it located\r\nin a vase?\r\n\u2022
    Is there a fence, trees, or other flowers around the bush?\r\n\u2022 Who cares
    for the bush?\r\n\u2022 And when the cold comes, how does he feel?\r\nTry to
    imagine, down to the finest detail, what it would be like to be a rosebush.\r\nMain
    part\r\nOpen your eyes and draw yourself as a rose bush. At first\r\nmake a sketch
    on a piece of paper with a simple pencil, and then\r\ncolor the drawing the way
    you want.\r\nInterpretation:\r\no Design size\r\nThe rose bush is drawn small
    in relation to the sheet of paper -\r\nspeaks of a person\u2019s uncertainty,
    the smaller the drawing\r\nrelation to the album sheet, the more clearly this
    quality manifests itself.\r\nThe rose bush is very large, it literally does not
    fit on the leaf\r\npaper - indicates a strong egocentric position and\r\nimpulsiveness.\r\no
    Color\r\nBlack, dark brown, gray and all dark colors in\r\nthe picture speaks
    of possible dysfunctional emotional\r\nhuman background.\r\nAll the bright, rich,
    warm colors and their shades, which\r\npainted drawing are signs of psychological\r\nwell-being
    and inner harmony.\r\no Favorable features of the drawing\r\nA lush bush with
    dense foliage, strong roots,\r\nnumerous buds or blossoming flowers,\r\nwhich
    grows with other similar bushes. For well-being\r\nthe internal state of a person
    can also be indicated by drawn\r\nsun, sky, bright flowers, absence of any fences,
    etc.\r\no Unfavorable signs of the drawing\r\nA large number of thorns and thorns
    on the branches is a sign\r\naggressiveness, but at the same time may indicate
    a need for protection,\r\nfeeling of security.\r\nBare branches without leaves,
    roots, bush growing alone in the desert\r\nor literally hangs in the air - they
    talk about possible internal\r\nloneliness, emptiness, lack of warmth.\r\nBroken
    flowers on a bush or cut in a vase are a sign of trouble and possible psychological
    trauma.\r\nA fence, fence or palisade around a bush - indicates\r\nsuppression
    of some fears in oneself, restrictions in actions.\r\nThe drawing is located
    at the bottom of the album sheet - it speaks of\r\nmental discomfort.\r\nCorrection
    of internal state\r\nWhat to do if your drawing contains a large number\r\nunfavorable
    signs? You can change it yourself\r\nyour condition. To do this for two weeks
    again and again\r\ndraw a rose bush, imagining how it is cared for, how it is\r\nwater
    it, and after some time the buds bloom on it,\r\nbright green young leaves appear.
    The bush can change, but\r\nafter it, your condition will change, you will change."
  PolishText: "Technika r\xF3\u017Canego krzewu Johna Alana\r\nCel: Uzyskanie informacji
    o wewn\u0119trznym \u015Bwiecie danej osoby. \r\nRysuj\u0105c krzak r\xF3\u017Cy,
    w rzeczywisto\u015Bci rysujesz sw\xF3j wewn\u0119trzny \u015Bwiat. \r\n\u015Bwiat,
    a krzew r\xF3\u017Cy jest metafor\u0105 stanu umys\u0142u.\r\nZalecenie: najpierw
    narysuj obrazek, a dopiero potem go uko\u0144cz. \r\npo jego uko\u0144czeniu
    i pokolorowaniu, a nast\u0119pnie przyjrzyj si\u0119 interpretacji.\r\nInwentarz:
    kartka papieru A4, kolorowe kredki, zwyk\u0142y o\u0142\xF3wek, farby akwarelowe.\r\no\u0142\xF3wek,
    farby akwarelowe lub flamastry.\r\nAlgorytm pracy\r\nWprowadzenie.\r\nUsi\u0105d\u017A
    wygodnie, zamknij oczy, zrelaksuj si\u0119, oddychaj r\xF3wnomiernie, \r\nkoncentruj\u0105c
    si\u0119 na doznaniach cielesnych. Pu\u015B\u0107 wodze \r\nwyobra\u017Ani i
    wyobra\u017A sobie, \u017Ce sta\u0142e\u015B si\u0119 krzakiem r\xF3\u017Cy,
    \r\ni przyjrzyj mu si\u0119 uwa\u017Cnie. \r\n- Czy jest ma\u0142y czy du\u017Cy,
    wysoki czy niski? \r\n- Czy ma kwiaty i czy s\u0105 one w p\u0105kach, czy z
    p\u0105kami? \r\na ga\u0142\u0119zie s\u0105 kolczaste, z li\u015B\u0107mi czy
    bez? \r\nczy bez? \r\n- Czy wyimaginowany krzew ma korzenie, jak g\u0142\u0119boko
    si\u0119gaj\u0105 one w ziemi\u0119? \r\nw ziemi\u0119. \r\n- I gdzie ro\u015Bnie
    krzew: w mie\u015Bcie, na pustyni, w kwietniku czy w wazonie? \r\nw wazonie?
    \r\n- Czy wok\xF3\u0142 krzewu jest ogrodzenie, drzewa, inne kwiaty? \r\n- Kto
    opiekuje si\u0119 krzewem? \r\n- A kiedy nadchodzi ch\u0142\xF3d, jakie to uczucie?
    \r\nSpr\xF3buj wyobrazi\u0107 sobie w najdrobniejszych szczeg\xF3\u0142ach, jak
    to jest by\u0107 krzewem r\xF3\u017Cy.\r\nCz\u0119\u015B\u0107 g\u0142\xF3wna\r\nOtw\xF3rz
    oczy i narysuj siebie jako krzew r\xF3\u017Cy. Najpierw \r\nnaszkicuj na kartce
    zwyk\u0142ym o\u0142\xF3wkiem, a nast\u0119pnie. \r\npokoloruj rysunek wed\u0142ug
    w\u0142asnego uznania.\r\nInterpretacja:\r\no Rozmiar rysunku\r\nKrzew r\xF3\u017Cy
    narysowany jako ma\u0142y w stosunku do kartki papieru - im mniejszy jest rysunek,
    tym mniejsza jest jego wielko\u015B\u0107.\r\nwskazuje na niepewno\u015B\u0107,
    im mniejszy jest rysunek. \r\nIm mniejszy jest rysunek w stosunku do szkicownika,
    tym bardziej \u017Cywa jest ta cecha.\r\nKrzew r\xF3\u017Cy jest bardzo du\u017Cy,
    dos\u0142ownie nie mie\u015Bci si\u0119 na kartce papieru - wskazuje na silne
    ego. \r\npapieru - wskazuje na siln\u0105 pozycj\u0119 egocentryczn\u0105 i impulsywno\u015B\u0107.
    \r\nimpulsywno\u015B\u0107.\r\no Kolor\r\nCzarny, ciemnobr\u0105zowy, szary i
    wszystkie ciemne kolory na rysunku wskazuj\u0105 na mo\u017Cliw\u0105 nieprzychylno\u015B\u0107.
    \r\nna rysunku wskazuj\u0105 na mo\u017Cliwe niekorzystne emocjonalne t\u0142o
    cz\u0142owieka. \r\nemocjonalne danej osoby.\r\nWszystkie jasne, soczyste, ciep\u0142e
    kolory i ich odcienie, z kt\xF3rych \r\nrysunku s\u0105 oznakami psychologicznego
    \r\ndobrego samopoczucia i wewn\u0119trznej harmonii.\r\no Korzystne oznaki rysunku\r\nBujny
    krzew o g\u0119stym ulistnieniu, silnych korzeniach, licznych p\u0105kach lub
    kwiatach. \r\nliczne p\u0105ki lub kwitn\u0105ce kwiaty, \r\nkt\xF3ry ro\u015Bnie
    z innymi podobnymi krzewami. Dobre samopoczucie \r\nwewn\u0119trznego stanu osoby
    mo\u017Ce by\u0107 r\xF3wnie\u017C wskazywane przez namalowane \r\ns\u0142o\u0144ce,
    niebo, jaskrawe kwiaty, brak ogrodze\u0144 itp.\r\no Niekorzystne znaki rysunku\r\nDu\u017Ca
    liczba cierni i kolc\xF3w na ga\u0142\u0119ziach jest oznak\u0105 \r\nagresywno\u015Bci,
    ale jednocze\u015Bnie mo\u017Ce oznacza\u0107 potrzeb\u0119 ochrony, \r\npoczucie
    bezpiecze\u0144stwa.\r\nGo\u0142e ga\u0142\u0119zie bez li\u015Bci, korzeni,
    krzew ro\u015Bnie samotnie na pustyni. \r\nlub wisi dos\u0142ownie w powietrzu
    - m\xF3wi o mo\u017Cliwej wewn\u0119trznej samotno\u015Bci. \r\nSamotno\u015B\u0107,
    opuszczenie, brak ciep\u0142a.\r\nPo\u0142amane kwiaty na krzaku lub \u015Bci\u0119te
    kwiaty w wazonie - oznaka niekorzystnej sytuacji, mo\u017Cliwy uraz psychiczny.\r\nOgrodzenie,
    \u017Cywop\u0142ot lub palisada wok\xF3\u0142 krzewu - wskazuje na \r\nt\u0142umienie
    niekt\xF3rych l\u0119k\xF3w w sobie, ograniczenia w dzia\u0142aniach.\r\nRysunek
    znajduje si\u0119 w dolnej cz\u0119\u015Bci arkusza albumu - wskazuje na \r\ndyskomfort
    psychiczny.\r\nKorekta stanu wewn\u0119trznego\r\nCo zrobi\u0107, je\u015Bli
    rysunek zawiera du\u017C\u0105 liczb\u0119 dysfunkcyjnych znak\xF3w? \r\ndysfunkcyjnych
    znak\xF3w? Mo\u017Cesz zmieni\u0107 \r\nsw\xF3j stan umys\u0142u. Aby to zrobi\u0107,
    przez dwa tygodnie, w k\xF3\u0142ko. \r\nnarysuj krzew r\xF3\u017Cy, wyobra\u017Caj\u0105c
    sobie, jak si\u0119 o niego dba, jak si\u0119 go podlewa. \r\nPodlewany, jak
    po chwili rozkwitaj\u0105 p\u0105ki r\xF3\u017C, \r\npojawiaj\u0105 si\u0119
    jasnozielone m\u0142ode li\u015Bcie. Krzew mo\u017Ce si\u0119 zmieni\u0107, a
    \r\nKrzew mo\u017Ce si\u0119 zmieni\u0107, a tw\xF3j stan zmieni si\u0119 wraz
    z nim, a ty si\u0119 zmienisz."
