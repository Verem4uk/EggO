  m_Script: {fileID: 11500000, guid: 4f59830c2394c044cbfd4a4df643124d, type: 3}
  m_Name: Practice11
  m_EditorClassIdentifier: 
  ID: 88
  IsPractice: 1
  RussianText: "\u0422\u0435\u0445\u043D\u0438\u043A\u0430: \xAB\u0414\u0438\u0430\u043B\u043E\u0433\xBB\r\n\u0426\u0435\u043B\u044C:
    \u043A\u043E\u0440\u0440\u0435\u043A\u0446\u0438\u044F \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0439
    \u0441\u0444\u0435\u0440\u044B. \u0417\u0430\u0434\u0430\u0447\u0438: \u043F\u0440\u043E\u0440\u0430\u0431\u043E\u0442\u043A\u0430
    \r\n\u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0445 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u043E\u0432\r\n\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C:
    \u041C\u0435\u0442\u0430\u0444\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0430\u0441\u0441\u043E\u0446\u0438\u0430\u0442\u0438\u0432\u043D\u044B\u0435
    \u043A\u0430\u0440\u0442\u044B. \r\n\u0412\u0440\u0435\u043C\u044F \u0440\u0430\u0431\u043E\u0442\u044B:
    30 \u043C\u0438\u043D\u0443\u0442.\r\n\u0412\u043E\u0437\u0440\u0430\u0441\u0442\u043D\u044B\u0435
    \u0440\u0430\u043C\u043A\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F:
    \u0441 18 \u043B\u0435\u0442. \r\n\u041E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u0438\u044F:
    \u043B\u044E\u0434\u0438 \u0441 \u043F\u0441\u0438\u0445\u0438\u0447\u0435\u0441\u043A\u0438\u043C\u0438
    \u0437\u0430\u0431\u043E\u043B\u0435\u0432\u0430\u043D\u0438\u044F\u043C\u0438.\r\n\u0410\u043B\u0433\u043E\u0440\u0438\u0442\u043C
    \u0440\u0430\u0431\u043E\u0442\u044B:\r\n\u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F.
    \u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439
    \u0432\u0434\u043E\u0445-\u0432\u044B\u0434\u043E\u0445. \u0412\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u0435
    \u0438 \r\n\u043F\u043E\u0434\u0443\u043C\u0430\u0439\u0442\u0435 \u043E \u0442\u043E\u043C
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0435, \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C
    \u0431\u044B \u0432\u044B \u0445\u043E\u0442\u0435\u043B\u0438 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.
    \r\n\u0412\u044B\u0442\u044F\u043D\u0438\u0442\u0435 \u0432\u0441\u043B\u0435\u043F\u0443\u044E
    \u043A\u0430\u0440\u0442\u0443 \u0438\u0437 \u043A\u043E\u043B\u043E\u0434\u044B,
    \u0434\u0443\u043C\u0430\u044F \u043E \u043D\u0435\u043C.\r\n\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
    \u043D\u0430 \u043A\u0430\u0440\u0442\u0443. \u041A\u0430\u043A \u043E\u043D\u0430
    \u0430\u0441\u0441\u043E\u0446\u0438\u0438\u0440\u0443\u0435\u0442\u0441\u044F
    \u0443 \u0432\u0430\u0441 \u0441 \u0442\u0435\u043C \r\n\u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C,
    \u043F\u0440\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432\u044B
    \u0434\u0443\u043C\u0430\u043B\u0438.\r\n\u0412\u043E\u043F\u0440\u043E\u0441\u044B:\r\n1.
    \u0427\u0442\u043E \u0432\u044B \u0432\u0438\u0434\u0438\u0442\u0435 \u043D\u0430
    \u043A\u0430\u0440\u0442\u0435?\r\n2. \u041A\u0430\u043A\u0438\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0430
    \u0443 \u0432\u0430\u0441 \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u043B\u0438,
    \u043A\u043E\u0433\u0434\u0430 \u0432\u044B \u0434\u0443\u043C\u0430\u043B\u0438
    \u043E \r\n\u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0435?\r\n3. \u041A\u0430\u043A
    \u043E\u043D\u0438 \u0441\u043E\u043E\u0442\u043D\u043E\u0441\u044F\u0442\u0441\u044F
    \u0441 \u0434\u0430\u043D\u043D\u043E\u0439 \u043A\u0430\u0440\u0442\u043E\u0439?\r\n4.
    \u041A\u0430\u043A\u0438\u0435 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F
    \u0443 \u0432\u0430\u0441 \u0441\u0432\u044F\u0437\u0430\u043D\u044B \u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C?\r\n5.
    \u0427\u0442\u043E \u0432\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u0435\u043C\u0443
    \u0441\u043A\u0430\u0437\u0430\u0442\u044C?\r\n6. \u041A\u0430\u043A\u0438\u0435
    \u0443 \u0432\u0430\u0441 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044F \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E\u0442\u0441\u044F
    \u0432 \u0442\u0435\u043B\u0435?\r\n7. \u041A\u0430\u043A \u0432\u044B \u0434\u0443\u043C\u0430\u0435\u0442\u0435,
    \u0447\u0442\u043E \u0445\u043E\u0442\u0435\u043B \u0431\u044B \u0432\u0430\u043C
    \u0441\u043A\u0430\u0437\u0430\u0442\u044C \u044D\u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A?\r\n8.
    \u041A\u0430\u043A\u0438\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u0438
    \u044D\u043C\u043E\u0446\u0438\u0438 \u0443 \u0432\u0430\u0441 \u044D\u0442\u043E
    \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442?\r\n9. \u041A\u0430\u043A\u0438\u0435
    \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0442
    \u0443 \u0432\u0430\u0441 \u0432 \u0442\u0435\u043B\u0435 \u0441\u0435\u0439\u0447\u0430\u0441?\r\n10.
    \u0427\u0442\u043E\u0431\u044B \u0432\u044B \u0445\u043E\u0442\u0435\u043B\u0438,
    \u0447\u0442\u043E\u0431\u044B \u044D\u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
    \u0432\u0430\u043C \u0441\u043A\u0430\u0437\u0430\u043B?\r\n11. \u041A\u0430\u043A
    \u0432\u044B \u0434\u0443\u043C\u0430\u0435\u0442\u0435, \u0447\u0442\u043E\u0431\u044B
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0445\u043E\u0442\u0435\u043B \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
    \u043E\u0442 \u0432\u0430\u0441?"
