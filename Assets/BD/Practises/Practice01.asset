  m_Script: {fileID: 11500000, guid: 4f59830c2394c044cbfd4a4df643124d, type: 3}
  m_Name: Practice01
  m_EditorClassIdentifier: 
  ID: 78
  IsPractice: 1
  RussianText: "\u0422\u0435\u0445\u043D\u0438\u043A\u0430 \xAB\u041C\u043E\u044F
    \u0446\u0435\u043B\u044C\xBB \u0410\u0432\u0442\u043E\u0440 \u0410\u043B\u0435\u043D\u0430
    \u0429\u0435\u0440\u0431\u044E\u043A\r\n\u0426\u0435\u043B\u044C: \u043F\u043E\u043C\u043E\u0447\u044C
    \u043A\u043B\u0438\u0435\u043D\u0442\u0443 \u0432\u044B\u0431\u0440\u0430\u0442\u044C
    \u043F\u0440\u0438\u043E\u0440\u0438\u0442\u0435\u0442\u043D\u044B\u0435 \u0437\u0430\u0434\u0430\u0447\u0438
    \u043D\u0430 \r\n\u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0435 3-6 \u043C\u0435\u0441\u044F\u0446\u0435\u0432
    \u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439
    \u043F\u043B\u0430\u043D \u043F\u043E \u0438\u0445 \r\n\u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044E.\r\n\u0410\u043B\u0433\u043E\u0440\u0438\u0442\u043C
    \u0440\u0430\u0431\u043E\u0442\u044B: \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C
    \u043A\u043B\u0438\u0435\u043D\u0442\u0430 \u0432\u044B\u043F\u0438\u0441\u0430\u0442\u044C
    \u043D\u0430 \u043B\u0438\u0441\u0442 \u043E\u0442 3 \u0434\u043E 7 \r\n\u0446\u0435\u043B\u0435\u0439,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u043B\u044F \u043D\u0435\u0433\u043E(\u043D\u0435\u0435)
    \u0432\u0430\u0436\u043D\u044B \u0438 \u043F\u0440\u043E\u0430\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0438\u0445 \u043F\u043E \r\n\u0441\u0442\u0435\u043F\u0435\u043D\u0438 \u0432\u0430\u0436\u043D\u043E\u0441\u0442\u0438
    \u043E\u0442 1 \u0434\u043E 10. \u0413\u0434\u0435 1 \u2014 \u0446\u0435\u043B\u044C
    \u043D\u0435\u0432\u0430\u0436\u043D\u0430, 10 \u2014 \u043E\u0447\u0435\u043D\u044C
    \u0432\u0430\u0436\u043D\u0430.\r\n1. \u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C
    \u043A\u043B\u0438\u0435\u043D\u0442\u0443 \u043F\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u0441 \u0441\u0430\u043C\u043E\u0439 \u0432\u0430\u0436\u043D\u043E\u0439 \u0446\u0435\u043B\u044C\u044E.
    \r\n\u041E\u0442\u0432\u0435\u0442\u0438\u0442\u044C \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441:
    \xAB\u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u0442\u0441\u044F \u0432
    \u0412\u0430\u0448\u0435\u0439 \u0436\u0438\u0437\u043D\u0438, \u043A\u043E\u0433\u0434\u0430
    \u0412\u044B \u0434\u043E\u0441\u0442\u0438\u0433\u043D\u0435\u0442\u0435 \r\n\u0446\u0435\u043B\u0438?\xBB
    \r\n2. \u0427\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0441\u0442\u0430\u0442\u044C
    \u043F\u0440\u0435\u0433\u0440\u0430\u0434\u043E\u0439 \u043D\u0430 \u043F\u0443\u0442\u0438
    \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F \u0446\u0435\u043B\u0438?\r\n3.
    \u041A\u0442\u043E \u0438\u043B\u0438 \u0447\u0442\u043E \u043C\u043E\u0436\u0435\u0442
    \u043F\u043E\u043C\u043E\u0447\u044C \u0412\u0430\u043C \u0432 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u0438
    \u0446\u0435\u043B\u0438?\r\n4. \u041A\u0430\u043A\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439
    \u0448\u0430\u0433 \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
    \u0443\u0436\u0435 \u0441\u0435\u0439\u0447\u0430\u0441 \u0434\u043B\u044F \r\n\u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044F
    \u0446\u0435\u043B\u0438?\r\n5. \u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C
    \u043A\u043B\u0438\u0435\u043D\u0442\u0443 \u043F\u0440\u043E\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u0435\u0449\u0435 2-3 \u0446\u0435\u043B\u0438 \u0438 \u043F\u0440\u043E\u043F\u0438\u0441\u0430\u0442\u044C
    \r\n\u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435 \u0448\u0430\u0433\u0438
    \u043F\u043E \u0438\u0445 \u0434\u043E\u0441\u0442\u0438\u0436\u0435\u043D\u0438\u044E"
  EnglishText: "\u201CMy Goal\u201D Technique Author Alena Shcherbyuk\r\nGoal: to
    help the client choose priority tasks for\r\nthe next 3-6 months and draw up
    a specific plan for them\r\nachievement.\r\nWork algorithm: ask the client to
    write down on a sheet from 3 to 7\r\ngoals that are important to him/her and
    analyze them according to\r\ndegrees of importance from 1 to 10. Where 1 means
    the goal is not important, 10 means it is very important.\r\n1. Invite the client
    to work with the most important goal.\r\nAnswer the question: \u201CWhat will
    happen in your life when you reach\r\ngoals?\"\r\n2. What could become an obstacle
    to achieving your goal?\r\n3. Who or what can help you achieve your goal?\r\n4.
    What first step can you take now to\r\nachieving the goal?\r\n5. Invite the client
    to work on 2-3 more goals and write down\r\nconcrete steps to achieve them"
  PolishText: "Technika \"M\xF3j cel\" Autor: Alena Scherbyuk\r\nCel: pom\xF3c klientowi
    wybra\u0107 priorytetowe zadania na najbli\u017Csze 3-6 miesi\u0119cy i stworzy\u0107
    konkretny plan ich realizacji. \r\ni stworzy\u0107 konkretny plan ich realizacji.
    \r\nosi\u0105gni\u0119cia.\r\nAlgorytm pracy: popro\u015B klienta o wypisanie
    na kartce od 3 do 7 cel\xF3w, kt\xF3re s\u0105 dla niego wa\u017Cne i stworzenie
    konkretnego planu ich osi\u0105gni\u0119cia. \r\ncel\xF3w, kt\xF3re s\u0105 dla
    niego wa\u017Cne i przeanalizowanie ich w kolejno\u015Bci od 1 do 10. \r\nw kolejno\u015Bci
    od 1 do 10. Gdzie 1 jest nieistotne, 10 jest bardzo wa\u017Cne.\r\n1. Popro\u015B
    klienta o prac\u0119 nad najwa\u017Cniejszym celem. \r\nOdpowiedz na pytanie:
    \"Co stanie si\u0119 w Twoim \u017Cyciu, gdy osi\u0105gniesz ten cel? \r\ncel?\".
    \r\n2. Co mo\u017Ce by\u0107 przeszkod\u0105 w osi\u0105gni\u0119ciu celu?\r\n3.
    Kto lub co mo\u017Ce pom\xF3c w osi\u0105gni\u0119ciu celu?\r\n4. Jaki jest pierwszy
    krok, kt\xF3ry mo\u017Cesz teraz zrobi\u0107, aby \r\naby osi\u0105gn\u0105\u0107
    sw\xF3j cel?\r\n5. Popro\u015B klienta o opracowanie 2-3 kolejnych cel\xF3w i
    zapisanie konkretnych krok\xF3w do ich osi\u0105gni\u0119cia. \r\nkonkretne kroki
    do ich osi\u0105gni\u0119cia"
