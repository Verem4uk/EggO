  m_Name: Practice04
  m_EditorClassIdentifier: 
  ID: 81
  IsPractice: 1
  RussianText: "\u0422\u0435\u0445\u043D\u0438\u043A\u0438 \u0440\u0430\u0431\u043E\u0442\u044B
    \u0441 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435\u043C \u0432
    \u0442\u0435\u043B\u0435\r\n\u0426\u0435\u043B\u044C: \u0432\u044B\u044F\u0432\u0438\u0442\u044C
    \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u044C \u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
    \u043A \u043E\u0431\u0449\u0435\u043D\u0438\u044E; \u0441\u0442\u0435\u043F\u0435\u043D\u044C\r\n\u0441\u043E\u0446\u0438\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438;
    \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0443\u043C\u0435\u043D\u0438\u0435 \u043A\u043E\u043D\u0442\u0430\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0441 \u043B\u044E\u0434\u044C\u043C\u0438.\r\n\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C:
    \u0431\u0435\u043B\u044B\u0439 \u043B\u0438\u0441\u0442 \u0444\u043E\u0440\u043C\u0430\u0442\u0430
    \u04104, \u043F\u043B\u0430\u0441\u0442\u0438\u043B\u0438\u043D.\r\n\u0412\u0440\u0435\u043C\u044F
    \u0440\u0430\u0431\u043E\u0442\u044B: 30\u201340 \u043C\u0438\u043D\u0443\u0442.\r\n\u0412\u043E\u0437\u0440\u0430\u0441\u0442\u043D\u044B\u0435
    \u0440\u0430\u043C\u043A\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F:
    \u043E\u0442 10 \u043B\u0435\u0442.\r\n\u0410\u043B\u0433\u043E\u0440\u0438\u0442\u043C
    \u0440\u0430\u0431\u043E\u0442\u044B\r\n\u0421\u044F\u0434\u044C\u0442\u0435
    \u0443\u0434\u043E\u0431\u043D\u043E, \u043F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435
    \u0441\u0442\u043E\u043F\u044B \u043D\u0430 \u043F\u043E\u043B. \u041F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435
    \u043E\u043F\u043E\u0440\u0443. \r\n\u0417\u0430\u043A\u0440\u043E\u0439\u0442\u0435
    \u0433\u043B\u0430\u0437\u0430. \u041F\u0440\u043E\u0441\u043A\u0430\u043D\u0438\u0440\u0443\u0439\u0442\u0435
    \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C \u0432\u0437\u043E\u0440\u043E\u043C
    \u0441\u0432\u043E\u0435 \u0442\u0435\u043B\u043E \u043E\u0442 \r\n\u043C\u0430\u043A\u0443\u0448\u043A\u0438
    \u0434\u043E \u043A\u043E\u043D\u0447\u0438\u043A\u043E\u0432 \u043F\u0430\u043B\u044C\u0446\u0435\u0432
    \u043D\u043E\u0433. \r\n\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u043C\u0435\u0441\u0442\u043E,
    \u0433\u0434\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0433\u043E
    \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F. \u0420\u0430\u0441\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
    \u044D\u0442\u043E \r\n\u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435.
    \r\n\u2022 \u041D\u0430 \u0447\u0442\u043E \u043E\u043D\u043E \u043F\u043E\u0445\u043E\u0436\u0435?
    \r\n\u2022 \u0424\u043E\u0440\u043C\u0430? \r\n\u2022 \u0426\u0432\u0435\u0442?
    \r\n\u2022 \u0420\u0430\u0437\u043C\u0435\u0440? \r\n\u2022 \u0417\u0430\u043F\u0430\u0445?
    \r\n\u2022 \u041E\u043D\u043E \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
    \u0438\u043B\u0438 \u043D\u0435\u0442? \r\n\u0427\u0435\u043C \u044F\u0440\u0447\u0435
    \u0432\u044B \u0435\u0433\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435,
    \u0442\u0435\u043C \u043B\u0443\u0447\u0448\u0435.\r\n\u0422\u0435\u043F\u0435\u0440\u044C
    \u043E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u0433\u043B\u0430\u0437\u0430.
    \u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u043B\u0430\u0441\u0442\u0438\u043B\u0438\u043D
    \u0438\u043B\u0438 \u0442\u0435\u0441\u0442\u043E, \u0442\u043E\u0433\u043E \r\n\u0446\u0432\u0435\u0442\u0430,
    \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432\u0430\u0448\u0435 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435.
    \u0412\u044B\u043B\u0435\u043F\u0438\u0442\u0435 \u0438\u0437 \u044D\u0442\u043E\u0433\u043E
    \u043A\u0443\u0441\u043E\u0447\u043A\u0430 \u0432\u0430\u0448 \r\n\u043E\u0431\u0440\u0430\u0437
    \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F. \r\n\u041F\u043E\u0441\u043B\u0435
    \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043E\u0431\u0440\u0430\u0437 \u0433\u043E\u0442\u043E\u0432,
    \u043E\u0442\u0432\u0435\u0442\u044C\u0442\u0435 \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441\u044B:\r\n1.\u0427\u0442\u043E
    \u0432\u044B \u0441\u043E\u0437\u0434\u0430\u043B\u0438? \u0414\u0430\u0439\u0442\u0435
    \u0438\u043C\u044F \u0432\u0430\u0448\u0435\u043C\u0443 \u043E\u0431\u0440\u0430\u0437\u0443.
    \r\n2. \u041F\u043E\u0447\u0435\u043C\u0443 \u0431\u044B\u043B\u043E \u0432\u0430\u0436\u043D\u043E
    \u0441\u043E\u0437\u0434\u0430\u0442\u044C \u0438\u043C\u0435\u043D\u043D\u043E
    \u0442\u0430\u043A? \u041E \u0447\u0435\u043C \u044D\u0442\u043E \u0432\u0430\u043C?
    \r\n3. \u041A\u0430\u043A\u0438\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0430
    \u0438 \u044D\u043C\u043E\u0446\u0438\u0438 \u0431\u044B\u043B\u0438 \u0432 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0435
    \u0440\u0430\u0431\u043E\u0442\u044B? \u041A\u0430\u043A\u0438\u0435 \r\n\u0441\u0435\u0439\u0447\u0430\u0441?
    \r\n4.\u0414\u043B\u044F \u0447\u0435\u0433\u043E \u043C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E
    \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0432 \u044D\u0442\u043E\u043C
    \u043C\u0435\u0441\u0442\u0435? (\u043E\u043D\u043E \u043A\u0430\u043A \r\n\u043F\u0430\u043D\u0446\u0438\u0440\u044C,
    \u043A\u0430\u043A \u0437\u0430\u0449\u0438\u0442\u0430, \u0438\u043B\u0438 \u043A\u0430\u043A
    \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0430, \u044F \u0431\u0435\u0437 \u044D\u0442\u043E\u0433\u043E
    \u0443\u0436\u0435 \u043D\u0435 \u043C\u043E\u0433\u0443, \u043A\u0430\u043A
    \r\n\u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435 \u043C\u043D\u0435
    \u043E \u0447\u0435\u043C-\u0442\u043E...)\r\n5.\u0427\u0442\u043E \u044F \u043C\u043E\u0433\u0443
    \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0432 \u0441\u0432\u043E\u0451\u043C
    \u043E\u0431\u0440\u0430\u0437\u0435 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F,
    \u0447\u0442\u043E\u0431\u044B \u043E\u043D\u043E \r\n\u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u043B\u043E\u0441\u044C?
    \u0427\u0442\u043E\u0431\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E
    \u0441\u0435\u0431\u044F \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E,
    \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u0435\u043D\u043D\u043E, \r\n\u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E?
    \r\n\u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u044D\u0442\u043E. \u0418\u0437\u043C\u0435\u043D\u0438\u0442\u0435
    \u043E\u0431\u0440\u0430\u0437. \r\n\u041F\u0440\u043E\u0441\u043B\u0435\u0434\u0438\u0442\u0435
    \u0437\u0430 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044F\u043C\u0438 \u0432
    \u0442\u0435\u043B\u0435. \r\n\u2022 \u0423\u0448\u043B\u043E \u043B\u0438 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435?
    \r\n\u2022 \u041A\u0430\u043A \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
    \u0441\u0435\u0431\u044F \u0441\u0435\u0439\u0447\u0430\u0441?"
  EnglishText: "Techniques for working with tension in the body\r\nGoal: identify
    the need and ability to communicate; degree\r\nsocialization; improve your ability
    to communicate with people.\r\nEquipment: white A4 sheet, plasticine.\r\nWorking
    time: 30\u201340 minutes.\r\nAge range of use: from 10 years.\r\nWork algorithm\r\nSit
    comfortably, place your feet on the floor. Feel the support.\r\nClose your eyes.
    Scan your body with your mind's eye\r\ntop of the head to the tips of the toes.\r\nFind
    the place where the most tension is. Consider this\r\nvoltage.\r\n\u2022 What
    does it look like?\r\n\u2022 Form?\r\n\u2022 Color?\r\n\u2022 Size?\r\n\u2022
    Smell?\r\n\u2022 Does it move or not?\r\nThe more vividly you present it, the
    better.\r\nNow open your eyes. Choose plasticine or dough\r\nthe color of which
    is your tension. Make your own from this piece\r\nimage of tension.\r\nAfter
    the image is ready, answer the questions:\r\n1.What did you create? Give your
    image a name.\r\n2. Why was it important to create it this way? What is this
    about?\r\n3. What feelings and emotions did you have during the work process?
    Which\r\nNow?\r\n4.Why do I need tension in this place? (it's like\r\nshell,
    as protection, or as a habit, I can no longer live without it, how\r\nreminding
    me of something...)\r\n5.What can I change in my image of tension so that it\r\nrelaxed?
    To feel comfortable, relaxed,\r\nsafely?\r\nDo it. Change the image.\r\nNotice
    the sensations in your body.\r\n\u2022 Has the tension gone away?\r\n\u2022 How
    do you feel now?"
  PolishText: "Techniki pracy z napi\u0119ciem w ciele\r\nCel: identyfikacja potrzeby
    i umiej\u0119tno\u015Bci komunikowania si\u0119; stopie\u0144 socjalizacji; poprawa
    umiej\u0119tno\u015Bci kontaktowania si\u0119 z lud\u017Ami.\r\nStopie\u0144
    uspo\u0142ecznienia; poprawa umiej\u0119tno\u015Bci kontaktowania si\u0119 z
    lud\u017Ami.\r\nMateria\u0142y: bia\u0142a kartka A4, plastelina.\r\nCzas pracy:
    30-40 minut.\r\nZakres wiekowy zastosowania: od 10 roku \u017Cycia.\r\nAlgorytm
    pracy\r\nUsi\u0105d\u017A wygodnie, po\u0142\xF3\u017C stopy na pod\u0142odze.
    Poczuj podparcie. \r\nZamknij oczy. Przeskanuj swoje cia\u0142o od czubka g\u0142owy
    do czubk\xF3w palc\xF3w u st\xF3p. \r\nOd czubka g\u0142owy do czubk\xF3w palc\xF3w
    u st\xF3p. \r\nZnajd\u017A miejsce, w kt\xF3rym odczuwasz najwi\u0119ksze napi\u0119cie.
    Zbadaj to napi\u0119cie. \r\nnapi\u0119cie. \r\n- Jak ono wygl\u0105da? \r\n-
    Kszta\u0142t? \r\n- Kolor? \r\n- Rozmiar? \r\n- Zapach? \r\n- Porusza si\u0119
    czy nie? \r\nIm wyra\u017Aniej to sobie wyobrazisz, tym lepiej.\r\nTeraz otw\xF3rz
    oczy. Wybierz kawa\u0142ek plasteliny lub ciasta \r\nw kolorze swojego napi\u0119cia.
    Uformuj ten kawa\u0142ek plasteliny lub ciasta w obraz \r\nobraz swojego napi\u0119cia.
    \r\nGdy obraz b\u0119dzie gotowy, odpowiedz na pytania:\r\n1.Co stworzy\u0142e\u015B?
    Nadaj nazw\u0119 swojemu obrazkowi. \r\n2. Dlaczego wa\u017Cne by\u0142o stworzenie
    go w ten spos\xF3b? O co ci chodzi? \r\n3. Jakie uczucia i emocje towarzyszy\u0142y
    temu procesowi? Jakie s\u0105 teraz? \r\nteraz? \r\n4.Do czego potrzebuj\u0119
    napi\u0119cia w tym miejscu? (jest jak \r\njak skorupa, jak obrona, albo jak
    nawyk, nie mog\u0119 si\u0119 ju\u017C bez niego obej\u015B\u0107, jak \r\nprzypominaj\u0105ce
    mi o czym\u015B...)\r\n5.Co mog\u0119 zmieni\u0107 w moim obrazie napi\u0119cia,
    aby je rozlu\u017Ani\u0107? \r\nsi\u0119 rozlu\u017Ani\u0142o? Aby poczu\u0107
    si\u0119 komfortowo, zrelaksowanym, \r\nbezpiecznie? \r\nZr\xF3b to. Zmie\u0144
    obraz. \r\nObserwuj odczucia w swoim ciele. \r\n- Czy napi\u0119cie znikn\u0119\u0142o?
    \r\n- Jak si\u0119 teraz czujesz?"
