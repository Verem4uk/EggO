  ID: 89
  IsPractice: 1
  RussianText: "\u0422\u0435\u0445\u043D\u0438\u043A\u0430 \xAB\u041D\u0430\u0440\u0438\u0441\u0443\u0439
    \u0441\u0432\u043E\u0439 \u0433\u043D\u0435\u0432\xBB\r\n\u041E\u0434\u0438\u043D
    \u0438\u0437 \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u0432 \u0440\u0430\u0431\u043E\u0442\u044B
    \u0441\u043E \u0437\u043B\u043E\u0441\u0442\u044C\u044E \u2013 \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C
    \u0435\u0435. \r\n\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
    \u043A \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u0438 \u043D\u0435 \u0438\u043C\u0435\u044E\u0442
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u044F. \u0417\u043B\u043E\u0441\u0442\u044C
    (\u0433\u043D\u0435\u0432) \u043C\u043E\u0436\u043D\u043E \r\n\u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C
    \u0432 \u0432\u0438\u0434\u0435 \u0431\u0435\u0441\u0441\u0432\u044F\u0437\u043D\u044B\u0445
    \u043B\u0438\u043D\u0438\u0439 \u0438\u043B\u0438 \u0448\u0442\u0440\u0438\u0445\u043E\u0432.
    \u041F\u043E\u043D\u0430\u0434\u043E\u0431\u0438\u0442\u0441\u044F \u043B\u0438\u0441\u0442
    \r\n\u0431\u0443\u043C\u0430\u0433\u0438 \u0438 \u0446\u0432\u0435\u0442\u043D\u044B\u0435
    \u043A\u0430\u0440\u0430\u043D\u0434\u0430\u0448\u0438 \u0438\u043B\u0438 \u043A\u0440\u0430\u0441\u043A\u0438.\r\n\u0418\u041D\u0421\u0422\u0420\u0423\u041A\u0426\u0418\u042F:
    \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u044C\u0442\u0435\u0441\u044C \u0438
    \u043F\u0440\u0438\u043C\u0438\u0442\u0435 \u0443\u0434\u043E\u0431\u043D\u0443\u044E
    \u043F\u043E\u0437\u0443, \u0433\u043B\u0443\u0431\u043E\u043A\u043E \r\n\u0432\u0434\u043E\u0445\u043D\u0438\u0442\u0435
    \u0438 \u0432\u044B\u0434\u043E\u0445\u043D\u0438\u0442\u0435, \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0439\u0442\u0435
    \u0437\u0430 \u0441\u0432\u043E\u0438\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435\u043C
    \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0438 \r\n\u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u0435\u043D\u043D\u043E.
    \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u0435
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u0432\u044B\u0437\u0432\u0430\u043B\u0430 \u0443 \u0412\u0430\u0441 \r\n\u0441\u0438\u043B\u044C\u043D\u043E\u0435
    \u0447\u0443\u0432\u0441\u0442\u0432\u043E \u0437\u043B\u043E\u0441\u0442\u0438
    (\u0433\u043D\u0435\u0432\u0430). \u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u044C\u0442\u0435
    \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443, \u0443\u0441\u043B\u044B\u0448\u044C\u0442\u0435
    \r\n\u043B\u044E\u0434\u0435\u0439, \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0445
    \u0412\u0430\u0441.\r\n\u041F\u0440\u0438 \u044D\u0442\u043E\u043C \u043E\u0442\u043C\u0435\u0442\u044C\u0442\u0435:\r\n-
    \u0413\u0434\u0435 \u0438 \u043A\u0430\u043A \u0437\u0430\u0440\u043E\u0436\u0434\u0430\u043B\u0441\u044F
    \u0412\u0430\u0448 \u0433\u043D\u0435\u0432? \u0413\u0434\u0435 \u043E\u043D
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F?\r\n- \u041A\u0430\u043A\u043E\u0433\u043E
    \u043E\u043D \u0446\u0432\u0435\u0442\u0430? \u0418\u043C\u0435\u0435\u0442 \u043B\u0438
    \u0412\u0430\u0448 \u0433\u043D\u0435\u0432 \u0444\u043E\u0440\u043C\u0443? \u0415\u0441\u043B\u0438
    \u0438\u043C\u0435\u0435\u0442, \u0442\u043E \r\n\u043A\u0430\u043A\u0443\u044E?\r\n-
    \u0418\u0437 \u043A\u0430\u043A\u043E\u0433\u043E \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430
    \u043E\u043D \u0441\u043E\u0441\u0442\u043E\u0438\u0442? \u041B\u0435\u0433\u043A\u0438\u0439
    \u043E\u043D \u0438\u043B\u0438 \u0442\u044F\u0436\u0435\u043B\u044B\u0439? \r\n\u041C\u044F\u0433\u043A\u0438\u0439
    \u0438\u043B\u0438 \u0443\u043F\u0440\u0443\u0433\u0438\u0439? \u0425\u043E\u043B\u043E\u0434\u043D\u044B\u0439
    \u0438\u043B\u0438 \u0433\u043E\u0440\u044F\u0447\u0438\u0439?\r\n- \u0415\u0441\u0442\u044C
    \u043B\u0438 \u0443 \u0432\u0430\u0448\u0435\u0433\u043E \u0433\u043D\u0435\u0432\u0430
    \u0437\u0430\u043F\u0430\u0445, \u0432\u043A\u0443\u0441? \u041A\u0430\u043A
    \u0437\u0432\u0443\u0447\u0438\u0442 \u0412\u0430\u0448 \u0433\u043D\u0435\u0432?
    \r\n- \u041F\u043E\u043A\u0430 \u0412\u044B \u0435\u0433\u043E \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u043B\u0438,
    \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0438 \u043B\u0438 \u0432 \u043D\u0435\u043C
    \u043A\u0430\u043A\u0438\u0435-\u0442\u043E \r\n\u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F?
    \u041A\u0430\u043A\u043E\u0432 \u0412\u0430\u0448 \u0433\u043D\u0435\u0432 \u0441\u0435\u0439\u0447\u0430\u0441?\r\n-
    \u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0442\u043E, \u0447\u0442\u043E
    \u0412\u0430\u043C \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0441 \u043D\u0438\u043C
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C\u2026\r\n\u0410 \u0442\u0435\u043F\u0435\u0440\u044C
    \u043E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u0433\u043B\u0430\u0437\u0430,
    \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435 3 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0445
    \u0432\u0434\u043E\u0445\u0430 \u0438 \u0432\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C
    \r\n\u0432 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043C\u043E\u043C\u0435\u043D\u0442,
    \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u0412\u044B \u0441\u0435\u0439\u0447\u0430\u0441
    \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C. \u041D\u0430\u0440\u0438\u0441\u0443\u0439\u0442\u0435
    \u0441\u0432\u043E\u0439 \r\n\u0433\u043D\u0435\u0432. \u0418\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u0442\u0435
    \u0441\u0432\u043E\u0438 \u043D\u0435\u0433\u0430\u0442\u0438\u0432\u043D\u044B\u0435
    \u0447\u0443\u0432\u0441\u0442\u0432\u0430, \u0432\u044B\u0431\u0438\u0440\u0430\u044F
    \u0442\u0435 \u0446\u0432\u0435\u0442\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435\r\n\u0431\u043E\u043B\u044C\u0448\u0435
    \u0432\u0441\u0435\u0433\u043E \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0442
    \u0412\u0430\u0448\u0435\u043C\u0443 \u0434\u0443\u0448\u0435\u0432\u043D\u043E\u043C\u0443
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044E.\r\n\u041A\u043E\u0433\u0434\u0430
    \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435, \u0447\u0442\u043E
    \u0412\u0430\u0448\u0435 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435
    \u0441\u043D\u0438\u0437\u0438\u043B\u043E\u0441\u044C, \r\n\u043F\u043E\u0441\u0442\u0430\u0440\u0430\u0439\u0442\u0435\u0441\u044C
    \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0440\u0438\u0441\u0443\u043D\u043E\u043A
    \u043D\u0430 \u043F\u043E\u0437\u0438\u0442\u0438\u0432\u043D\u044B\u0439: \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0438\u0442\u0435
    \u0440\u0438\u0441\u0443\u043D\u043E\u043A \r\n\u043B\u044E\u0431\u043E\u0439
    \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439 \u0438 \u0434\u043E\u0440\u0438\u0441\u0443\u0439\u0442\u0435
    \u0435\u0433\u043E \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0446\u0432\u0435\u0442\u0430\u043C\u0438.
    \u0414\u0435\u043B\u0430\u0439\u0442\u0435 \u044D\u0442\u043E \u0434\u043E \u0442\u0435\u0445
    \r\n\u043F\u043E\u0440, \u043F\u043E\u043A\u0430 \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
    \u0442\u044F\u0436\u0435\u043B\u044B\u0445 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u043D\u0438\u0439
    \u0432\u043D\u0443\u0442\u0440\u0438. \u0415\u0441\u043B\u0438 \u0436\u0435 \r\n\u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
    \u0441\u0432\u043E\u0439 \u0440\u0438\u0441\u0443\u043D\u043E\u043A \u043D\u0430
    \u043F\u043E\u0437\u0438\u0442\u0438\u0432\u043D\u044B\u0439 \u043D\u0435 \u0443\u0434\u0430\u0435\u0442\u0441\u044F,
    \u0438 \u043E\u043D \u0432\u0441\u0435 \u0440\u0430\u0432\u043D\u043E \r\n\u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442
    \u043D\u0435\u0433\u0430\u0442\u0438\u0432, \u0432\u0441\u0435\u0433\u0434\u0430
    \u043E\u0441\u0442\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0434\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439
    \u0432\u0430\u0440\u0438\u0430\u043D\u0442 \u2013 \u0441\u043C\u044F\u0442\u044C
    \u0438\u043B\u0438 \r\n\u043F\u043E\u0440\u0432\u0430\u0442\u044C \u0435\u0433\u043E
    \u043D\u0430 \u043C\u0435\u043B\u043A\u0438\u0435 \u043A\u0443\u0441\u043E\u0447\u043A\u0438!
    \u041F\u0440\u043E\u0434\u0435\u043B\u044B\u0432\u0430\u044F \u044D\u0442\u043E,
    \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0439\u0442\u0435,
    \u043A\u0430\u043A \r\n\u0412\u0430\u0448\u0430 \u044F\u0440\u043E\u0441\u0442\u044C
    \u0432\u044B\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0432 \u044D\u0442\u043E\u043C
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0438."
  EnglishText: "The \"Draw Your Anger\" technique\r\nOne way to work with anger is
    to paint it. \r\nPainting ability does not matter. Anger can be \r\ndrawn as
    incoherent lines or strokes. You'll need a piece \r\nof paper and colored pencils
    or paints.\r\nINSTRUCTION: Relax and assume a comfortable posture, breathe in
    and out deeply. \r\ninhale and exhale, and observe your state of mind in a calm
    and \r\nand relaxed. Now recall a situation that caused you to have \r\na strong
    feeling of anger. Visualize the situation, hear \r\nthe people around you.\r\nIn
    doing so, note:\r\n- Where and how did your anger originate? Where is it located?\r\n-
    What color is it? Does your anger have a form? If so. \r\nwhat kind?\r\n- What
    material is it made of? Is it light or heavy? \r\nIs it soft or firm? Is it cold
    or hot?\r\n- Does your anger have an odor, a taste? What does your anger sound
    like? \r\n- While you were looking at it, did it change in any way. \r\nchange?
    What is your anger like now?\r\n- Do what you want to do with it....\r\nNow,
    open your eyes, take three deep breaths and come back \r\nto the present moment,
    to where you are right now. Draw your \r\nanger. Depict your negative feelings
    by choosing the colors that\r\nthat most closely match your state of mind.\r\nWhen
    you feel that your tension has decreased, \r\ntry to change the drawing to a
    positive one by turning it over. \r\non either side and paint it with other colors.
    Do this until \r\nuntil there are no more heavy feelings left inside. If \r\nyou
    can't change your drawing to a positive one and it's still \r\nand it's still
    negative, there's always the radical option of crumpling or \r\nor tear it into
    little pieces! As you do this, visualize \r\nyour rage is being expressed in
    this action."
  PolishText: "Technika \"Narysuj sw\xF3j gniew\"\r\nJednym ze sposob\xF3w pracy
    z gniewem jest namalowanie go. \r\nUmiej\u0119tno\u015B\u0107 malowania nie ma
    znaczenia. Z\u0142o\u015B\u0107 mo\u017Ce by\u0107 \r\nnarysowana jako niesp\xF3jne
    linie lub poci\u0105gni\u0119cia. Potrzebny b\u0119dzie kawa\u0142ek \r\npapieru
    i kolorowe kredki lub farby.\r\nINSTRUKCJA: Zrelaksuj si\u0119 i przyjmij wygodn\u0105
    pozycj\u0119, we\u017A g\u0142\u0119boki wdech i wydech. \r\nWdech i wydech,
    obserwuj sw\xF3j stan umys\u0142u w spokojny i zrelaksowany spos\xF3b. \r\nzrelaksowany.
    Teraz przypomnij sobie sytuacj\u0119, kt\xF3ra wywo\u0142a\u0142a \r\nsilne uczucie
    z\u0142o\u015Bci. Wyobra\u017A sobie sytuacj\u0119, us\u0142ysz \r\nludzi wok\xF3\u0142
    ciebie.\r\nZwr\xF3\u0107 przy tym uwag\u0119:\r\n- Gdzie i w jaki spos\xF3b powsta\u0142a
    z\u0142o\u015B\u0107? Gdzie si\u0119 znajduje?\r\n- Jakiego jest koloru? Czy
    z\u0142o\u015B\u0107 ma jaki\u015B kszta\u0142t? Je\u015Bli tak. \r\nJakiego
    rodzaju?\r\n- Z jakiego materia\u0142u jest wykonany? Czy jest lekki czy ci\u0119\u017Cki?
    \r\nCzy jest mi\u0119kki czy twardy? Jest zimny czy gor\u0105cy?\r\n- Czy z\u0142o\u015B\u0107
    ma zapach, smak? Jak brzmi tw\xF3j gniew? \r\n- Czy podczas patrzenia na ni\u0105
    zmieni\u0142a si\u0119 w jakikolwiek spos\xF3b. \r\nzmieni\u0142 si\u0119? Jaki
    jest teraz tw\xF3j gniew?\r\n- Zr\xF3b z ni\u0105 to, co chcesz zrobi\u0107....\r\nTeraz
    otw\xF3rz oczy, we\u017A trzy g\u0142\u0119bokie oddechy i wr\xF3\u0107 \r\ndo
    chwili obecnej, do miejsca, w kt\xF3rym si\u0119 teraz znajdujesz. Narysuj sw\xF3j
    \r\nz\u0142o\u015B\u0107. Przedstaw swoje negatywne uczucia, wybieraj\u0105c
    kolory, kt\xF3re\r\nkt\xF3re najbardziej odpowiadaj\u0105 twojemu stanowi umys\u0142u.\r\nKiedy
    poczujesz, \u017Ce napi\u0119cie opad\u0142o, \r\nspr\xF3buj zmieni\u0107 rysunek
    na pozytywny: odwr\xF3\u0107 rysunek. \r\npo obu stronach i pomaluj go innymi
    kolorami. R\xF3b to tak d\u0142ugo, a\u017C \r\na\u017C do momentu, gdy w \u015Brodku
    nie b\u0119dzie ju\u017C \u017Cadnych ci\u0119\u017Ckich uczu\u0107. Je\u015Bli
    \r\nje\u015Bli nie mo\u017Cesz zmieni\u0107 swojego rysunku na pozytywny i nadal
    jest on \r\nnegatywny, zawsze pozostaje drastyczna opcja zgniecenia lub \r\nlub
    podarcie go na ma\u0142e kawa\u0142ki! Kiedy to robisz, wizualizuj \r\nTwoja
    w\u015Bciek\u0142o\u015B\u0107 wyra\u017Ca si\u0119 w tym dzia\u0142aniu."
