  m_Script: {fileID: 11500000, guid: ff3b0881c561d3f4492f08ad0a16829b, type: 3}
  m_Name: Translation 82
  m_EditorClassIdentifier: 
  RussianText: "\u0422\u0435\u0445\u043D\u0438\u043A\u0430 \xAB\u041A\u0443\u0432\u0448\u0438\u043D
    \u0438 \u043E\u0440\u0443\u0436\u0438\u0435\xBB\r\n\u0426\u0435\u043B\u044C:\r\n\u2022
    \u0432\u044B\u044F\u0432\u043B\u0435\u043D\u0438\u0435 \u0430\u0440\u0445\u0435\u0442\u0438\u043F\u043E\u0432
    \u043C\u0443\u0436\u0441\u043A\u043E\u0433\u043E \u0438 \u0436\u0435\u043D\u0441\u043A\u043E\u0433\u043E
    \u043D\u0430\u0447\u0430\u043B\u0430 \u0432 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0435;
    \r\n\u2022 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435
    \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0439 \u0438\u0445 \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F;
    \r\n\u2022 \u0438\u0434\u0435\u043D\u0442\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u044F
    \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u0438 \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438
    \u0433\u0435\u043D\u0434\u0435\u0440\u043D\u044B\u043C\u0438 \r\n\u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0449\u0438\u043C\u0438;
    \r\n\u2022 \u043F\u043E\u0438\u0441\u043A \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432
    \u0441\u0430\u043C\u043E\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \r\n\u0417\u0430\u0434\u0430\u0447\u0438:\r\n\u2713 \u0443\u0447\u0438\u0442\u044C\u0441\u044F
    \u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0438 \u0441\u043B\u044B\u0448\u0430\u0442\u044C
    \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0435 \xAB\u042F\xBB;\r\n\u2713
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u0442\u044C \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
    \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442, \u0447\u0443\u0432\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C,
    \xAB\u042F\xBB \r\n\u0431\u0435\u0441\u0441\u043E\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435,
    \u0442\u0430\u043A\u0442\u0438\u043B\u044C\u043D\u044B\u0435 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044F
    \u0438 \u043C\u0435\u043B\u043A\u0443\u044E \u043C\u043E\u0442\u043E\u0440\u0438\u043A\u0443
    \u0440\u0443\u043A;\r\n\u2713 \u0444\u043E\u0440\u043C\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043D\u0430\u0432\u044B\u043A \u0440\u0435\u0444\u043B\u0435\u043A\u0441\u0438\u0438
    \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0433\u0435\u043D\u0434\u0435\u0440\u043D\u044B\u0445
    \r\n\u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0439 \u0432 \u0434\u0438\u0430\u0434\u0435
    \xAB\u0436\u0435\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C\xBB
    \u2013 \xAB\u043C\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u044C\xBB.\r\n\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C:
    \u043F\u043B\u0430\u0441\u0442\u0438\u043B\u0438\u043D \u0440\u0430\u0437\u043D\u044B\u0445
    \u0446\u0432\u0435\u0442\u043E\u0432, \u0431\u0435\u043B\u044B\u0439 \u043B\u0438\u0441\u0442
    \u0431\u0443\u043C\u0430\u0433\u0438 (\u04104).\r\n\u0412\u0440\u0435\u043C\u044F
    \u0440\u0430\u0431\u043E\u0442\u044B: 40\u201345 \u043C\u0438\u043D\u0443\u0442.\r\n\u0412\u043E\u0437\u0440\u0430\u0441\u0442\u043D\u044B\u0435
    \u0440\u0430\u043C\u043A\u0438 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u044F:
    \u043E\u0442 13 \u043B\u0435\u0442.\r\n\u0410\u043B\u0433\u043E\u0440\u0438\u0442\u043C
    \u0440\u0430\u0431\u043E\u0442\u044B\r\n\u0412\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435\r\n\u041A\u0430\u0436\u0434\u043E\u043C\u0443
    \u043A\u043B\u0438\u0435\u043D\u0442\u0443 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F
    \u0432\u044B\u0431\u0440\u0430\u0442\u044C \u043B\u044E\u0431\u043E\u0439 \u043A\u0443\u0441\u043E\u043A
    \r\n\u043F\u043B\u0430\u0441\u0442\u0438\u043B\u0438\u043D\u0430 \u0438\u0437
    \u043A\u043E\u0440\u043E\u0431\u043A\u0438 \u0438, \u0440\u0430\u0437\u043C\u0438\u043D\u0430\u044F
    \u0435\u0433\u043E, \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F
    \u0441 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u043C, \r\n\u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0435\u0433\u043E \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430 \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438.\r\n\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
    \u0447\u0430\u0441\u0442\u044C\r\n\u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
    \u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E\r\n1. \u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u0435
    \u043A\u0443\u0441\u043E\u043A \u043F\u043B\u0430\u0441\u0442\u0438\u043B\u0438\u043D\u0430
    \u043D\u0430 \u0434\u0432\u0435 \u0447\u0430\u0441\u0442\u0438, \u043D\u0435
    \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E \r\n\u0440\u0430\u0432\u043D\u044B\u0435,
    \u043A\u0430\u043A \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0435\u0442 \u0432\u0430\u043C
    \u0438\u043D\u0442\u0443\u0438\u0446\u0438\u044F.\r\n2. \u0418\u0437 \u043E\u0434\u043D\u043E\u0439
    \u0447\u0430\u0441\u0442\u0438 \u043F\u043B\u0430\u0441\u0442\u0438\u043B\u0438\u043D\u0430
    \u0432\u044B\u043B\u0435\u043F\u0438\u0442\u0435 \u043A\u0443\u0432\u0448\u0438\u043D,
    \u0438\u0437 \u0434\u0440\u0443\u0433\u043E\u0439 \u2013\r\n\u043E\u0440\u0443\u0436\u0438\u0435.\r\n3.
    \u0420\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u0412\u0430\u0448\u0438
    \u0438\u0437\u0434\u0435\u043B\u0438\u044F \u043D\u0430 \u0431\u0435\u043B\u043E\u043C
    \u043B\u0438\u0441\u0442\u0435 \u0431\u0443\u043C\u0430\u0433\u0438 \u043F\u0435\u0440\u0435\u0434
    \u0441\u043E\u0431\u043E\u0439.\r\n4. \u041E\u0442\u0432\u0435\u0442\u044C\u0442\u0435
    \u043D\u0430 \u0432\u043E\u043F\u0440\u043E\u0441\u044B:\r\n\u2022 \u041A\u0430\u043A
    \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E\u0442 \u0441\u0435\u0431\u044F
    \u043A\u0443\u0432\u0448\u0438\u043D \u0438 \u043E\u0440\u0443\u0436\u0438\u0435?\r\n\u2022
    \u0427\u0442\u043E \u0441\u0442\u0430\u0440\u0448\u0435?\r\n\u2022 \u0427\u0435\u0439
    \u043E\u0431\u0440\u0430\u0437 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
    \u0432 \u0412\u0430\u0448\u0435\u043C \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0438
    \u0440\u0430\u043D\u044C\u0448\u0435?\r\n\u2022 \u041A\u0430\u043A\u043E\u0432
    \u0438\u0445 \u0432\u043E\u0437\u0440\u0430\u0441\u0442?\r\n\u2022 \u0412 \u043A\u0430\u043A\u0438\u0445
    \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F\u0445 \u043C\u0435\u0436\u0434\u0443
    \u0441\u043E\u0431\u043E\u0439 \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F
    \u0412\u0430\u0448\u0438 \u043A\u0443\u0432\u0448\u0438\u043D \u0438 \r\n\u043E\u0440\u0443\u0436\u0438\u0435?\r\n\u2022
    \u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043E\u043D\u0438 \u0412\u0430\u043C
    \u043D\u0440\u0430\u0432\u044F\u0442\u0441\u044F?\r\n\u2022 \u041A\u0430\u043A\u043E\u0432,
    \u0441 \u0412\u0430\u0448\u0435\u0439 \u0442\u043E\u0447\u043A\u0438 \u0437\u0440\u0435\u043D\u0438\u044F,
    \u0441\u043C\u044B\u0441\u043B \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \u044D\u0442\u0438\u0445 \r\n\u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432?\r\n\u2022
    \u041A\u0430\u043A\u043E\u0439 \u0434\u0435\u0432\u0438\u0437 \u0443 \u0412\u0430\u0448\u0435\u0433\u043E
    \u043A\u0443\u0432\u0448\u0438\u043D\u0430? \u0423 \u0412\u0430\u0448\u0435\u0433\u043E
    \u043E\u0440\u0443\u0436\u0438\u044F?\r\n\u2022 \u0415\u0441\u043B\u0438 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C,
    \u0447\u0442\u043E \u043A\u0443\u0432\u0448\u0438\u043D \u2013 \u044D\u0442\u043E
    \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0435
    \r\n\u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0412\u0430\u0448\u0435\u0439
    \u0436\u0435\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438,
    \u0430 \u043E\u0440\u0443\u0436\u0438\u0435 \u2013 \u043C\u0443\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0441\u0442\u0438,
    \u0442\u043E \r\n\u043A\u0430\u043A\u043E\u0439 \u0441\u043C\u044B\u0441\u043B
    \u0438\u043C\u0435\u044E\u0442 \u0434\u043B\u044F \u0412\u0430\u0441 \u044D\u0442\u0438
    \u043E\u0431\u0440\u0430\u0437\u044B?\r\n\u0412\u044B\u0432\u043E\u0434\u044B.
    \u0412 \u043A\u0430\u0436\u0434\u043E\u043C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0435
    \u0437\u0430\u043B\u043E\u0436\u0435\u043D\u044B \u0430\u0440\u0445\u0435\u0442\u0438\u043F\u044B
    \u043C\u0443\u0436\u0441\u043A\u043E\u0433\u043E \u0438 \r\n\u0436\u0435\u043D\u0441\u043A\u043E\u0433\u043E
    \u043D\u0430\u0447\u0430\u043B\u0430. \u0412 \u0442\u0435\u0445\u043D\u0438\u043A\u0435
    \xAB\u041A\u0443\u0432\u0448\u0438\u043D \u0438 \u043E\u0440\u0443\u0436\u0438\u0435\xBB
    \u043A\u0443\u0432\u0448\u0438\u043D \u043E\u0442\u043E\u0431\u0440\u0430\u0436\u0430\u0435\u0442
    \r\n\u0436\u0435\u043D\u0441\u043A\u043E\u0435 \u043D\u0430\u0447\u0430\u043B\u043E
    \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u0430 \u043E\u0440\u0443\u0436\u0438\u0435
    \u2013 \u043C\u0443\u0436\u0441\u043A\u043E\u0435. \r\n\u0422\u0435\u0445\u043D\u0438\u043A\u0430
    \xAB\u041A\u0443\u0432\u0448\u0438\u043D \u0438 \u043E\u0440\u0443\u0436\u0438\u0435\xBB
    \u0434\u0430\u0451\u0442 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \r\n\u043E\u0442\u0432\u0435\u0442\u044B
    \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B:\r\n\u2022
    \u041A\u0430\u043A \u043A\u043B\u0438\u0435\u043D\u0442 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0441\u044F
    \u043A \u0441\u0432\u043E\u0435\u043C\u0443 \u0436\u0435\u043D\u0441\u043A\u043E\u043C\u0443
    \u0438 \u043C\u0443\u0436\u0441\u043A\u043E\u043C\u0443 \u043D\u0430\u0447\u0430\u043B\u0443?\r\n\u2022
    \u041A\u0430\u043A\u043E\u0439 \u043E\u0431\u0440\u0430\u0437 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
    \u0440\u0430\u043D\u044C\u0448\u0435 \u0432 \u0435\u0433\u043E \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0435\u043C
    \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0435?\r\n\u2022
    \u0412 \u043A\u0430\u043A\u0438\u0445 \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F\u0445
    \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439 \u043D\u0430\u0445\u043E\u0434\u044F\u0442\u0441\u044F
    \u044D\u0442\u0438 \u0434\u0432\u0430 \u043D\u0430\u0447\u0430\u043B\u0430: \r\n\u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442
    \u043B\u0438 \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0442\u0438\u0432\u043D\u043E,
    \u0434\u043E\u043F\u043E\u043B\u043D\u044F\u044E\u0442 \u0434\u0440\u0443\u0433
    \u0434\u0440\u0443\u0433\u0430 \u0438\u043B\u0438 \r\n\u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0443\u044E\u0442?\r\n\u2022
    \u041D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043A\u043B\u0438\u0435\u043D\u0442
    \u0440\u0435\u0430\u043B\u0438\u0437\u0443\u0435\u0442 \u0432 \u0441\u0432\u043E\u0435\u0439
    \u0436\u0438\u0437\u043D\u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437
    \u0434\u0432\u0443\u0445 \r\n\u0430\u0440\u0445\u0435\u0442\u0438\u043F\u043E\u0432?\r\n\u2022
    \u0415\u0441\u0442\u044C \u043B\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B
    \u0432 \u0432\u043E\u0441\u043F\u0440\u0438\u044F\u0442\u0438\u0438 \u0441\u0432\u043E\u0435\u0439
    \u0433\u0435\u043D\u0434\u0435\u0440\u043D\u043E\u0439 \u0440\u043E\u043B\u0438?\r\n\u2022
    \u041A\u0430\u043A\u0438\u0435 \u0441\u0438\u043B\u044C\u043D\u044B\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
    \u0432\u043E\u0437\u043D\u0438\u043A\u0448\u0438\u0445 \u043E\u0431\u0440\u0430\u0437\u043E\u0432,
    \u043A\u0430\u043A\u043E\u0439 \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B
    \r\n\u0434\u043B\u044F \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u043D\u043E\u0433\u043E
    \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u044F
    \u0432\u0438\u0434\u0438\u0442 \u043A\u043B\u0438\u0435\u043D\u0442?"
  EnglishText: "Technique \"Jug and weapon\"\r\nTarget:\r\n\u2022 identification
    of archetypes of masculine and feminine principles in a person;\r\n\u2022 determination
    of strategies for their interaction;\r\n\u2022 personal identification with one\u2019s
    gender\r\ncomponents;\r\n\u2022 search for self-improvement resources\r\nTasks:\r\n\u2713
    learn to listen and hear the inner \u201CI\u201D;\r\n\u2713 develop emotional
    intelligence, sensitivity, \u201CI\u201D\r\nunconscious, tactile sensations and
    fine motor skills;\r\n\u2713 develop the skill of reflecting your own gender\r\nstates
    in the \u201Cfemininity\u201D \u2013 \u201Cmasculinity\u201D dyad.\r\nEquipment:
    plasticine of different colors, white sheet of paper (A4).\r\nWorking time: 40\u201345
    minutes.\r\nAge range of use: from 13 years.\r\nWork algorithm\r\nIntroduction\r\nEach
    client is invited to choose any piece\r\nplasticine from the box and, kneading
    it, get to know the material,\r\nfeel its physical properties and capabilities.\r\nMain
    part\r\nInstructions for action\r\n1. Divide a piece of plasticine into two parts,
    optional\r\nequal, as your intuition will tell you.\r\n2. From one part of plasticine,
    fashion a jug, from the other -\r\nweapon.\r\n3. Place your items on a white
    sheet of paper in front of you.\r\n4. Answer the questions:\r\n\u2022 How do
    the jug and weapon feel?\r\n\u2022 Which is older?\r\n\u2022 Whose image appeared
    in your imagination first?\r\n\u2022 What is their age?\r\n\u2022 What is the
    relationship between your jug and\r\nweapon?\r\n\u2022 How much do you like them?\r\n\u2022
    What, from your point of view, is the meaning of the existence of these\r\nitems?\r\n\u2022
    What is the motto of your jug? Your weapon?\r\n\u2022 If we assume that the jug
    is symbolic\r\ndisplay of your femininity, and weapons \u2013 masculinity, then\r\nWhat
    meaning do these images have for you?\r\nConclusions. Each person contains archetypes
    of masculinity and\r\nfeminine. In the \u201CJug and Weapons\u201D technique,
    the jug displays\r\nthe feminine principle of man, and the weapon is masculine.\r\nThe
    \u201CJug and Weapon\u201D technique makes it possible to get\r\nanswers to the
    following questions:\r\n\u2022 How does the client relate to his feminine and
    masculine aspects?\r\n\u2022 Which image appeared first in his inner space?\r\n\u2022
    What are the relationships between these two principles:\r\ninteract constructively,
    complement each other, or\r\nconflict?\r\n\u2022 To what extent does the client
    implement each of the two in his life?\r\narchetypes?\r\n\u2022 Are there any
    problems in perceiving your gender role?\r\n\u2022 What are the strengths of
    the emerging images, what is the potential\r\nfor personal improvement the client
    sees?"
  PolishText: "Technika dzbanka i pistoletu\r\nCel:\r\n- Identyfikacja archetyp\xF3w
    m\u0119sko\u015Bci i kobieco\u015Bci w cz\u0142owieku; \r\n- okre\u015Blenie
    strategii ich interakcji; \r\n- identyfikacja osobowo\u015Bci z jej komponentami
    \r\nkomponenty; \r\n- poszukiwanie zasob\xF3w samodoskonalenia \r\nCele:\r\n\u2713
    nauka s\u0142uchania i s\u0142yszenia wewn\u0119trznego \"ja\";\r\n\u2713 rozw\xF3j
    inteligencji emocjonalnej, zmys\u0142owo\u015Bci, \"ja\" \r\nnie\u015Bwiadomo\u015Bci,
    zmys\u0142\xF3w dotykowych i umiej\u0119tno\u015Bci motorycznych;\r\n\u2713 rozwija\u0107
    umiej\u0119tno\u015B\u0107 refleksji nad w\u0142asn\u0105 p\u0142ci\u0105 \r\nstany
    w diadzie \"kobieco\u015B\u0107\" - \"m\u0119sko\u015B\u0107\".\r\nMateria\u0142y:
    plastelina w r\xF3\u017Cnych kolorach, bia\u0142a kartka papieru (A4).\r\nCzas
    pracy: 40-45 minut.\r\nPrzedzia\u0142 wiekowy: od 13 lat.\r\nAlgorytm pracy\r\nWprowadzenie\r\nKa\u017Cdy
    klient jest proszony o wybranie dowolnego kawa\u0142ka \r\nplasteliny z pude\u0142ka
    i ugniatanie go, aby zapozna\u0107 si\u0119 z materia\u0142em, \r\npoczu\u0107
    jego w\u0142a\u015Bciwo\u015Bci fizyczne i mo\u017Cliwo\u015Bci.\r\nCz\u0119\u015B\u0107
    g\u0142\xF3wna\r\nInstrukcje dotycz\u0105ce dzia\u0142ania\r\n1. Podziel kawa\u0142ek
    plasteliny na dwie cz\u0119\u015Bci, niekoniecznie r\xF3wne. \r\nniekoniecznie
    r\xF3wne, zgodnie z intuicj\u0105.\r\n2) Z jednej cz\u0119\u015Bci plasteliny
    uformuj dzbanek, z drugiej - bro\u0144.\r\nbro\u0144.\r\n3. Umie\u015B\u0107
    swoje produkty na bia\u0142ej kartce papieru przed sob\u0105.\r\n4. Odpowiedz
    na pytania:\r\n- Jakie wra\u017Cenie sprawia dzbanek i bro\u0144?\r\n- Kt\xF3ry
    jest starszy?\r\n- Czyj obraz pojawi\u0142 si\u0119 wcze\u015Bniej w Twojej wyobra\u017Ani?\r\n-
    Jaki jest ich wiek?\r\n- Jaki jest zwi\u0105zek mi\u0119dzy dzbanem a broni\u0105?
    \r\nbroni\u0105?\r\n- Jak bardzo je lubisz?\r\n- Co, z twojego punktu widzenia,
    jest racj\u0105 bytu tych przedmiot\xF3w? \r\nprzedmiot\xF3w?\r\n- Jakie jest
    motto twojego dzbanka? Jakie jest motto twojej broni?\r\n- Zak\u0142adaj\u0105c,
    \u017Ce dzban jest symboliczn\u0105 reprezentacj\u0105 \r\nkobieco\u015Bci, a
    bro\u0144 - m\u0119sko\u015Bci. \r\nJakie znaczenie maj\u0105 dla ciebie te obrazy?\r\nWnioski.
    Ka\u017Cda istota ludzka ma archetypy m\u0119sko\u015Bci i kobieco\u015Bci. \r\nkobieco\u015Bci.
    W technice \"Dzban i pistolet\" dzban reprezentuje \r\nkobieco\u015B\u0107, a
    bro\u0144 reprezentuje m\u0119sko\u015B\u0107. \r\nTechnika \"Dzban i pistolet\"
    daje nam mo\u017Cliwo\u015B\u0107 uzyskania odpowiedzi na nast\u0119puj\u0105ce
    pytania \r\nodpowiedzi na nast\u0119puj\u0105ce pytania:\r\n- Jak klient czuje
    si\u0119 ze swoj\u0105 kobieco\u015Bci\u0105 i m\u0119sko\u015Bci\u0105?\r\n-
    Kt\xF3ry obraz pojawi\u0142 si\u0119 wcze\u015Bniej w jego wewn\u0119trznej przestrzeni?\r\n-
    Jaki jest zwi\u0105zek mi\u0119dzy tymi dwoma pocz\u0105tkami: \r\nCzy oddzia\u0142uj\u0105
    one na siebie konstruktywnie, uzupe\u0142niaj\u0105 si\u0119, czy s\u0105 w konflikcie?
    \r\ns\u0105 w konflikcie?\r\n- W jakim stopniu klient realizuje w swoim \u017Cyciu
    ka\u017Cdy z dw\xF3ch archetyp\xF3w? \r\narchetyp\xF3w?\r\n- Czy s\u0105 jakie\u015B
    problemy w postrzeganiu swojej roli p\u0142ciowej?\r\n- Jakie mocne strony powsta\u0142ych
    obraz\xF3w, jaki potencja\u0142 osobistej poprawy widzi klient? \r\nJaki potencja\u0142
    osobistej poprawy widzi klient?"
