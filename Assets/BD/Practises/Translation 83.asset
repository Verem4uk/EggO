  m_Script: {fileID: 11500000, guid: ff3b0881c561d3f4492f08ad0a16829b, type: 3}
  m_Name: Translation 83
  m_EditorClassIdentifier: 
  RussianText: "\u0423\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u0435 \xAB\u0422\u043A\u0430\u043D\u0435\u0432\u044B\u0435
    \u0440\u0430\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438\xBB\r\n\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
    \u0437\u0430\u0434\u0430\u0447\u0430: \u043E\u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435
    \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u043C \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B,
    \u0441\u0432\u043E\u0435\u0433\u043E\r\n\u0443\u0447\u0430\u0441\u0442\u0438\u044F
    \u0432 \u043D\u0435\u0439 \u0438 \u0432\u044B\u0445\u043E\u0434 \u043D\u0430
    \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435\r\n\u0418\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044C:
    \u0446\u0432\u0435\u0442\u043D\u044B\u0435 \u043A\u0443\u0441\u043E\u0447\u043A\u0438
    \u0442\u043A\u0430\u043D\u0438, \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B,
    \u0438\u0433\u0440\u0443\u0448\u043A\u0438.\r\n\u0412\u0440\u0435\u043C\u044F:
    \u041E\u0442 40 \u0434\u043E 60 \u043C\u0438\u043D\u0443\u0442.\r\n\u0412\u043E\u0437\u0440\u0430\u0441\u0442\u043D\u044B\u0435
    \u0440\u0430\u043C\u043A\u0438: \u0441\u0442\u0430\u0440\u0448\u0435 18 \u043B\u0435\u0442.\r\n\u0410\u043B\u0433\u043E\u0440\u0438\u0442\u043C
    \u0440\u0430\u0431\u043E\u0442\u044B:\r\n1. \u0421\u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u0443\u0439\u0442\u0435
    \u0437\u0430\u043F\u0440\u043E\u0441 \u0438\u043B\u0438 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u0443,
    \u0430\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u0443\u044E \u043D\u0430 \u0442\u0435\u043A\u0443\u0449\u0438\u0439\r\n\u043C\u043E\u043C\u0435\u043D\u0442.
    \u041A\u0430\u043A \u044F \u043C\u043E\u0433\u0443 \u043D\u0430\u0438\u043B\u0443\u0447\u0448\u0438\u043C
    \u043E\u0431\u0440\u0430\u0437\u043E\u043C...?\r\n2. \u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u0435
    \u043A\u043B\u0438\u0435\u043D\u0442\u0443 \u0441\u043E\u0437\u0434\u0430\u0442\u044C
    \u0438\u0437 \u043F\u043E\u043B\u043E\u0442\u0435\u043D \xAB\u0442\u043A\u0430\u043D\u0435\u0432\u0443\u044E
    \u043A\u0430\u0440\u0442\u0438\u043D\u0443\xBB,\r\n\u043A\u043E\u0442\u043E\u0440\u0430\u044F
    \u043E\u0442\u0440\u0430\u0436\u0430\u043B\u0430 \u0431\u044B \u0432\u0430\u0448\u0443
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E. \u041C\u043E\u0436\u043D\u043E
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B,\r\n\u0438\u0433\u0440\u0443\u0448\u043A\u0438,
    \u043A\u0430\u043C\u0435\u0448\u043A\u0438.\r\n3. \u041F\u043E\u0441\u043B\u0435
    \u0441\u043E\u0437\u0434\u0430\u043D\u0438\u044F \u043A\u0430\u0440\u0442\u0438\u043D\u044B
    \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u0435 \u043A\u043B\u0438\u0435\u043D\u0442\u0443
    \u0434\u0430\u0442\u044C \u043E\u0442\u0432\u0435\u0442\u044B \u043D\u0430\r\n\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
    \u0440\u0430\u0437\u0432\u0438\u0432\u0430\u044E\u0449\u0438\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B:\r\n\u2713
    \u0413\u0434\u0435 \u0432 \u044D\u0442\u043E\u0439 \u043A\u043E\u043C\u043F\u043E\u0437\u0438\u0446\u0438\u0438
    \u0412\u044B? \u041A\u0430\u043A \u0412\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442\u0435?
    \u041A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u043E \u043B\u0438 \u0412\u0430\u043C\r\n\u0442\u0430\u043C?
    \u0415\u0441\u043B\u0438 \u0412\u0430\u0441 \u043D\u0435\u0442, \u0442\u043E
    \u043F\u043E\u0447\u0435\u043C\u0443 \u0431\u044B\u043B\u043E \u0432\u0430\u0436\u043D\u043E
    \u043D\u0435 \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0442\u044C \u0441\u0435\u0431\u044F?\r\n\u2713
    \u041A\u0430\u043A\u0438\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0430 \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u044E\u0442
    \u043F\u0440\u0438 \u0432\u0437\u0433\u043B\u044F\u0434\u0435 \u043D\u0430 \u043A\u0430\u0440\u0442\u0438\u043D\u0443?
    3-4 \u0447\u0443\u0432\u0441\u0442\u0432\u0430,\r\n\u044D\u043C\u043E\u0446\u0438\u0438.\r\n\u2713
    \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E \u043B\u0438 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C
    \u0447\u0442\u043E-\u043B\u0438\u0431\u043E \u0432 \u0440\u0430\u0431\u043E\u0442\u0435,
    \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0430\u043B\u043E \u043B\u0435\u0433\u0447\u0435\r\n\u0434\u044B\u0448\u0430\u0442\u044C,
    \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
    \u043D\u0430\u043C\u0435\u043A \u043D\u0430 \u0440\u0435\u0448\u0435\u043D\u0438\u0435?
    \u0427\u0442\u043E \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C, \u0447\u0442\u043E\r\n\u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C?\r\n\u2713
    \u0412\u0430\u0448\u0438 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u044F
    \u0432 \u043A\u0430\u0440\u0442\u0438\u043D\u0435 \u043C\u043E\u0433\u0443\u0442
    \u0431\u044B\u0442\u044C \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0430\u043C\u0438
    \u043E \u0412\u0430\u0448\u0438\u0445\r\n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u0445
    \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439 \u0436\u0438\u0437\u043D\u0438?
    \u0427\u0442\u043E \u044D\u0442\u043E \u0437\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F?\r\n\u2713
    \u0412\u043E\u0437\u044C\u043C\u0438\u0442\u0435 \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u0439
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0431\u0443\u0434\u0435\u0442 \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C\r\n\u043F\u0435\u0440\u0432\u044B\u0439
    \u0448\u0430\u0433 \u0432 \u0440\u0435\u0448\u0435\u043D\u0438\u0438\u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B
    (\u0431\u0443\u0441\u0438\u043D\u043A\u0430, \u0442\u0435\u0441\u0435\u043C\u043A\u0430,
    \u043F\u0443\u0433\u043E\u0432\u0438\u0446\u0430\u2026)\r\n\u043D\u0430\u0439\u0434\u0438\u0442\u0435
    \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u043C\u0435\u0441\u0442\u043E \u0432
    \u0438\u043D\u0441\u0442\u0430\u043B\u043B\u044F\u0446\u0438\u0438.\r\n\u2713
    \u041A\u0430\u043A \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u043E\u0441\u044C
    \u044D\u043C\u043E\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435
    \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043F\u043E\u0441\u043B\u0435
    \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430
    \u0440\u0435\u0448\u0435\u043D\u0438\u044F."
  EnglishText: "Exercise \"Tissue formations\"\r\nThe main task: the client's realization
    of the problem, his or her\r\nThe client realizes the problem, his/her participation
    in it and goes into action\r\nEquipment: colored pieces of fabric, objects, toys.\r\nTime:
    40 to 60 minutes.\r\nAge limits: over 18 years old.\r\nWork algorithm:\r\n1.
    Formulate a request or problem relevant to the current\r\nmoment. How can I best...?\r\n2.
    Invite the client to create a \"fabric painting\" out of the canvases,\r\nthat
    reflects your situation. You can use objects,\r\ntoys, pebbles.\r\n3. After creating
    the picture, invite the client to give answers to the following developmental
    questions.\r\nthe following developmental questions:\r\n\u2713 Where are you
    in this composition? How do you look? Are you comfortable\r\ncomfortable there?
    If you are not, why was it important not to place yourself?\r\n\u2713 What feelings
    arise when you look at the painting? 3-4 feelings,\r\nemotions.\r\n\u2713 Would
    it be possible to change something in the work to make it easier to\r\nto breathe,
    to get a hint of a solution? What to add, what\r\nchange?\r\n\u2713 Could your
    changes in the painting be clues about your\r\nactions in real life? What are
    those actions?\r\n\u2713 Take an unusual object to symbolize the first step in
    solving the problem.\r\nthe first step in solving the problem (a bead, a string,
    a button...).\r\nfind a place for it in the installation.\r\n\u2713 How did your
    emotional state change after adding the solution item."
  PolishText: "\u0106wiczenie \"Formacje tkankowe\"\r\nG\u0142\xF3wny cel: u\u015Bwiadomienie
    sobie przez klienta problemu, jego udzia\u0142u w nim i podj\u0119cie dzia\u0142ania.\r\nKlient
    rozpoznaje problem, sw\xF3j udzia\u0142 w nim i przyst\u0119puje do dzia\u0142ania.\r\nSprz\u0119t:
    kolorowe kawa\u0142ki materia\u0142u, przedmioty, zabawki.\r\nCzas: od 40 do
    60 minut.\r\nOgraniczenia wiekowe: powy\u017Cej 18 lat.\r\nAlgorytm pracy:\r\n1.
    Sformu\u0142owanie pytania lub problemu zwi\u0105zanego z bie\u017C\u0105c\u0105
    chwil\u0105.\r\nchwili. Jak mog\u0119 najlepiej...?\r\n2. Zapro\u015B klienta
    do stworzenia \"obrazu z tkaniny\" z p\u0142\xF3cien,\r\nkt\xF3ry odzwierciedla
    sytuacj\u0119. Mo\u017Cesz u\u017Cy\u0107 przedmiot\xF3w,\r\nprzedmiot\xF3w,
    zabawek, kamyk\xF3w.\r\n3. Po stworzeniu obrazu popro\u015B klienta o udzielenie
    odpowiedzi na nast\u0119puj\u0105ce pytania rozwojowe.\r\nnast\u0119puj\u0105ce
    pytania rozwojowe:\r\nGdzie jeste\u015B w tej kompozycji? Jak wygl\u0105dasz?
    Czy czujesz si\u0119\r\nkomfortowo? Je\u015Bli nie, dlaczego wa\u017Cne by\u0142o,
    aby nie umieszcza\u0107 siebie?\r\nJakie uczucia pojawiaj\u0105 si\u0119, gdy
    patrzysz na obraz? 3-4 uczucia,\r\nemocje.\r\n\u2713 Czy mo\u017Cna zmieni\u0107
    co\u015B w pracy, aby u\u0142atwi\u0107 oddychanie?\r\noddycha\u0107, uzyska\u0107
    podpowied\u017A rozwi\u0105zania? Co doda\u0107, co\r\nzmieni\u0107?\r\n\u2713
    Czy zmiany w obrazie mog\u0105 by\u0107 wskaz\xF3wkami na temat twoich dzia\u0142a\u0144
    w prawdziwym \u017Cyciu?\r\ndzia\u0142a\u0144 w prawdziwym \u017Cyciu? Jakie
    s\u0105 te dzia\u0142ania?\r\nWe\u017A nietypowy przedmiot, kt\xF3ry b\u0119dzie
    symbolizowa\u0142 pierwszy krok w rozwi\u0105zaniu problemu.\r\npierwszy krok
    w rozwi\u0105zaniu problemu (koralik, sznurek, guzik...).\r\nZnajd\u017A dla
    niego miejsce w instalacji.\r\nJak zmieni\u0142 si\u0119 stan emocjonalny po
    dodaniu elementu rozwi\u0105zania?\r\nG\u0142\xF3wne zadanie: u\u015Bwiadomienie
    sobie problemu przez klienta, jego/jej\r\nG\u0142\xF3wne zadanie: klient u\u015Bwiadamia
    sobie problem, sw\xF3j udzia\u0142 w nim i przyst\u0119puje do dzia\u0142ania.\r\nInwentarz:
    kolorowe kawa\u0142ki materia\u0142u, przedmioty, zabawki.\r\nCzas: od 40 do
    60 minut.\r\nOgraniczenia wiekowe: powy\u017Cej 18 lat.\r\nAlgorytm pracy:\r\n1.
    Sformu\u0142owanie pytania lub problemu zwi\u0105zanego z bie\u017C\u0105c\u0105
    chwil\u0105.\r\nchwili. Jak mog\u0119 najlepiej...?\r\n2. Zapro\u015B klienta
    do stworzenia \"obrazu z tkaniny\" z p\u0142\xF3cien,\r\nkt\xF3ry odzwierciedla
    sytuacj\u0119. Mo\u017Cesz u\u017Cy\u0107 przedmiot\xF3w,\r\nprzedmiot\xF3w,
    zabawek, kamyk\xF3w.\r\n3. Po stworzeniu obrazu popro\u015B klienta o udzielenie
    odpowiedzi na nast\u0119puj\u0105ce pytania rozwojowe.\r\nnast\u0119puj\u0105ce
    pytania rozwojowe:\r\nGdzie jeste\u015B w tej kompozycji? Jak wygl\u0105dasz?
    Czy czujesz si\u0119\r\nkomfortowo? Je\u015Bli nie, dlaczego wa\u017Cne by\u0142o,
    aby nie umieszcza\u0107 siebie?\r\nJakie uczucia pojawiaj\u0105 si\u0119, gdy
    patrzysz na obraz? 3-4 uczucia,\r\nemocje.\r\n\u2713 Czy mo\u017Cna zmieni\u0107
    co\u015B w pracy, aby u\u0142atwi\u0107 oddychanie?\r\noddycha\u0107, uzyska\u0107
    podpowied\u017A rozwi\u0105zania? Co doda\u0107, co\r\nzmieni\u0107?\r\n\u2713
    Czy zmiany w obrazie mog\u0105 by\u0107 wskaz\xF3wkami na temat twoich dzia\u0142a\u0144
    w prawdziwym \u017Cyciu?\r\ndzia\u0142a\u0144 w prawdziwym \u017Cyciu? Jakie
    s\u0105 te dzia\u0142ania?\r\nWe\u017A nietypowy przedmiot, kt\xF3ry b\u0119dzie
    symbolizowa\u0142 pierwszy krok w rozwi\u0105zaniu problemu.\r\npierwszy krok
    w rozwi\u0105zaniu problemu (koralik, sznurek, guzik...).\r\nZnajd\u017A dla
    niego miejsce w instalacji.\r\nJak zmieni\u0142 si\u0119 stan emocjonalny po
    dodaniu tego przedmiotu."
