rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function paidAccess(uid, level) {
      let path = /databases/$(database)/documents/eggoUsers/$(uid)/entitlements/current;
      return exists(path) && (
        get(path).data.get('permanent', false) == true ||
        get(path).data.get('subscriptionExpiresAt', timestamp.value(0)) > request.time ||
        get(path).data.get('levelExpiresAt', {}).get(string(level), timestamp.value(0)) > request.time
      );
    }

    match /eggoUsers/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['schemaVersion', 'completedLevel', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['schemaVersion', 'completedLevel', 'createdAt', 'updatedAt'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.completedLevel is int
        && request.resource.data.completedLevel >= 0
        && request.resource.data.completedLevel <= 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completedLevel', 'updatedAt'])
        && request.resource.data.completedLevel is int
        && request.resource.data.completedLevel >= resource.data.completedLevel
        && request.resource.data.completedLevel <= 7
        && request.resource.data.updatedAt == request.time
        && (request.resource.data.completedLevel == resource.data.completedLevel
          || request.resource.data.completedLevel <= 2
          || paidAccess(uid, request.resource.data.completedLevel));
      allow delete: if false;

      match /purchases/{purchaseId} {
        allow read: if owner(uid);
        // Only the future trusted payment backend (Admin SDK) writes payments.
        allow write: if false;
      }
      match /entitlements/{entitlementId} {
        allow read: if owner(uid);
        allow write: if false;
      }
    }

    // Deliberately no rule for the existing reviews collection here. Merge this
    // namespace into the CURRENT production rules; do not overwrite them blindly.
  }
}
